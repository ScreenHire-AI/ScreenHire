{
  "version": 1,
  "columns": [
    {
      "id": "1fe3f089-d5a2-41d3-a23a-3f1e86e8d50a",
      "name": "To Do",
      "role": "todo",
      "icon": "layers",
      "color": "#6b7280"
    },
    {
      "id": "73665f9e-605d-42df-9fc6-3716d06d935f",
      "name": "Planning",
      "icon": "map",
      "color": "#8b5cf6",
      "autoSpawn": true,
      "permissionMode": "plan",
      "modelOverride": "opus",
      "effortOverride": "xhigh",
      "planApproval": "automatic",
      "planExitTarget": "Executing"
    },
    {
      "id": "d33d4435-8173-40eb-9437-9143cf787ee0",
      "name": "Executing",
      "description": "Implements the brief. Ends \"Implementation: complete\" (pnpm verify:fast and the task's own tests green, run by class or file), then a findings pass ending \"Findings: applied\" moves it to Code Review.",
      "icon": "square-terminal",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "opus",
      "effortOverride": "high",
      "automations": {
        "onTurnEnd": [
          {
            "name": "On to Code Review",
            "type": "move_to_column",
            "finalLine": "Findings: applied",
            "maxRuns": 4,
            "targetColumn": "Code Review"
          },
          {
            "name": "Apply findings",
            "type": "send_message",
            "finalLine": "Implementation: complete",
            "message": "Check your last message for findings, recommendations or follow-up changes you have not applied yet, and apply them here in this task, not as follow-up tasks. Where one needs a decision, take your recommended option and name the alternative. If there are none, say so. If you changed anything, re-run /verify (pnpm verify:fast and the tests you added or changed) and commit. Either way, end your turn with a short summary and the line \"Findings: applied\".",
            "mode": "immediate"
          },
          {
            "name": "Dependency missing",
            "type": "notify",
            "finalLine": "Blocked: dependency not on main",
            "title": "Blocked on a dependency: #{{taskNumber}} {{title}}"
          }
        ]
      }
    },
    {
      "id": "8d7d067a-f4b7-4782-b965-14550bcbbea1",
      "name": "Code Review",
      "description": "Fresh-context /task-review: fixes findings, adds tests. \"Verdict: Ready\" → Testing; \"Verdict: Blocked\" → Executing (max 3).",
      "icon": "code",
      "color": "#f59e0b",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "opus",
      "effortOverride": "high",
      "sessionTarget": "isolated",
      "sessionSpawnStrategy": "always_spawn_new",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/task-review {{baseBranch}}",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Back for revisions",
            "type": "move_to_column",
            "finalLine": "Verdict: Blocked",
            "maxRuns": 3,
            "targetColumn": "Executing",
            "message": "Code Review sent this back. Do the numbered steps above its verdict, commit, then end your turn with a short summary and the line \"Findings: applied\".\n\n{{agentReply}}"
          },
          {
            "name": "On to Testing",
            "type": "move_to_column",
            "finalLine": "Verdict: Ready",
            "maxRuns": 3,
            "targetColumn": "Testing"
          },
          {
            "name": "Review stuck",
            "type": "notify",
            "finalLine": "Verdict: Blocked",
            "title": "Review blocked: #{{taskNumber}} {{title}}"
          }
        ]
      }
    },
    {
      "id": "bbc605fd-c21e-46f3-b0b3-78c6a897e2f4",
      "name": "Testing",
      "description": "/pull-request: merge origin/main, sync docs, fast local checks, one push, open + link PR, CI's Gate green on the head. \"PR: ready to merge\" → Merge.",
      "icon": "flask-conical",
      "color": "#06b6d4",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "On to Merge",
            "type": "move_to_column",
            "finalLine": "PR: ready to merge",
            "maxRuns": 3,
            "targetColumn": "Merge"
          },
          {
            "name": "Testing blocked",
            "type": "notify",
            "finalLine": "PR: blocked",
            "title": "Testing blocked: #{{taskNumber}} {{title}}"
          }
        ]
      }
    },
    {
      "id": "86b15f5e-0b1a-4a74-9278-88a2d343ee95",
      "name": "Merge",
      "description": "/merge-pull-request: Gate green on the head and mergeable, squash-merge (CI again only after a conflict), confirm on origin/main, realign. \"PR: merged\" → Done.",
      "icon": "merge",
      "color": "#f97316",
      "autoSpawn": true,
      "permissionMode": "auto",
      "modelOverride": "sonnet",
      "effortOverride": "high",
      "automations": {
        "onEnter": [
          {
            "name": "Message",
            "type": "send_message",
            "message": "/merge-pull-request",
            "mode": "immediate"
          }
        ],
        "onTurnEnd": [
          {
            "name": "Finish",
            "type": "move_to_column",
            "finalLine": "PR: merged",
            "maxRuns": 3,
            "targetColumn": "Done"
          },
          {
            "name": "Merge blocked",
            "type": "notify",
            "finalLine": "PR: blocked",
            "title": "Merge blocked: #{{taskNumber}} {{title}}"
          }
        ]
      }
    },
    {
      "id": "5f906943-df6f-4720-ac95-ae65f2891ca9",
      "name": "Done",
      "role": "done",
      "icon": "circle-check-big",
      "color": "#10b981"
    }
  ],
  "_modifiedBy": "7ef4fd0cb484"
}
