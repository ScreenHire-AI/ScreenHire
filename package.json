{
  "name": "screenhire",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "runed>@sveltejs/kit": "3"
      }
    }
  },
  "scripts": {
    "dev": "dotnet run --project apps/apphost",
    "build": "dotnet build ScreenHire.slnx && pnpm -r build",
    "check": "pnpm -r check",
    "generate:api": "dotnet build apps/api && pnpm --filter @screenhire/api-client generate"
  }
}
