{
  "name": "screenhire",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "runed>@sveltejs/kit": "3"
      }
    }
  },
  "scripts": {
    "dev": "dotnet run --project apps/apphost",
    "build": "dotnet build ScreenHire.slnx && pnpm -r build",
    "check": "pnpm -r check",
    "e2e:install": "node scripts/install-browsers.mjs",
    "generate:api": "dotnet build apps/api && pnpm --filter @screenhire/api-client generate",
    "verify": "pnpm verify:dotnet && pnpm verify:contract && pnpm check && pnpm -r build && pnpm -r --if-present test && pnpm verify:lighthouse && pnpm verify:test",
    "verify:dotnet": "dotnet build ScreenHire.slnx -warnaserror",
    "verify:contract": "pnpm --filter @screenhire/api-client generate && git diff --exit-code --stat -- packages/api-client",
    "verify:lighthouse": "pnpm --filter @screenhire/marketing lighthouse",
    "verify:test": "dotnet test --solution ScreenHire.slnx"
  }
}
