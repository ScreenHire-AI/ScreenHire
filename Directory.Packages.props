<Project>
  <!--
    Central package management. Licence policy (ADR-0008): prefer MIT / Apache-2.0 / BSD / PostgreSQL.
    Every new package or major-version bump needs a licence check before it lands here.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the "Transitive pins" group below override versions pulled in by other packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AspireVersion>13.6.1</AspireVersion>
    <DotNetVersion>10.0.13</DotNetVersion>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="$(AspireVersion)" />
    <!-- Community Toolkit hosting integrations version separately from Aspire; 13.6.0 targets Aspire.Hosting 13.6. -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.MailPit" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core / EF Core">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetVersion)" />
    <!-- MIT. IHttpClientFactory for the Google Indexing API client in ScreenHire.Application. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Job description rich text. MIT, as are its AngleSharp and AngleSharp.Css dependencies. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>
  <ItemGroup Label="Messaging">
    <!-- Wolverine (ADR-0008): MIT, as are its JasperFx, Weasel and Cronos dependencies; NewId is Apache-2.0. -->
    <PackageVersion Include="WolverineFx" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.51.1" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.51.1" />
    <!-- Roslyn for Wolverine's runtime handler code generation (TypeLoadMode.Dynamic); MIT, as is Microsoft.CodeAnalysis. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.1" />
  </ItemGroup>
  <ItemGroup Label="Job distribution">
    <!-- Apache-2.0, as are Google.Apis and Google.Apis.Core; Newtonsoft.Json is MIT. Service-account tokens for Google's Indexing API. -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.69.0" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup Label="Transitive pins">
    <!-- Aligns Aspire.Npgsql.EntityFrameworkCore.PostgreSQL (built against 10.0.12) with our EF Core version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotNetVersion)" />
    <!-- GHSA-qhrr-8q5h-9q3h: MessagePack < 2.5.303 (pulled in by the Aspire AppHost). -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx: System.Security.Cryptography.Pkcs 10.0.0 (pulled in by MailKit's MimeKit). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetVersion)" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- MIT. The .NET SignalR client, for the integration tests that connect to the real-time hub. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(DotNetVersion)" />
    <!-- Wrapper is MIT; its Deque.AxeCore.Commons dependency (axe-core) is MPL-2.0: a test-only exception (ADR-0008). -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
  </ItemGroup>
</Project>
