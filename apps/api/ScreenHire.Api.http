@api = http://localhost:5080

GET {{api}}/v1/public/organizations/brightwater/jobs
Accept: application/json

###

GET {{api}}/v1/jobs
Accept: application/json

###

GET {{api}}/v1/meta
Accept: application/json

###

# The dashboard routes below need a signed-in session cookie, and the POSTs and PUTs also need the antiforgery header
# (X-XSRF-TOKEN, the value of the XSRF-TOKEN cookie). Sign in through the dashboard first and copy both.
@xsrf = paste-the-XSRF-TOKEN-cookie-here

GET {{api}}/v1/templates
Accept: application/json

###

POST {{api}}/v1/jobs
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "title": "Platform Engineer",
  "templateVersionId": "0199e8a0-0000-7000-8000-000000000101",
  "applicantLocationRequirements": ["GB", "IE"],
  "salary": { "min": 70000, "max": 90000, "currency": "GBP" }
}

###

# Replace the ids with ones from the responses above.
POST {{api}}/v1/jobs/00000000-0000-0000-0000-000000000000/publish
X-XSRF-TOKEN: {{xsrf}}

###

POST {{api}}/v1/jobs/00000000-0000-0000-0000-000000000000/applications
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "candidate": { "fullName": "Jordan Example", "email": "jordan@example.com" },
  "accommodationRequested": false,
  "aiUseDeclaration": "DidNotUse"
}

###

# A resume for a candidate added by hand: PUT the file to uploadUrl, then send uploadId as resumeUploadId above.
POST {{api}}/v1/jobs/00000000-0000-0000-0000-000000000000/applications/resume-uploads
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "fileName": "jordan-example.pdf", "sizeBytes": 48213 }

###

# The dashboard's Ctrl K: candidates by name or email, jobs by title.
GET {{api}}/v1/search?q=jordan

###

POST {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/move
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "toStageId": "screening", "note": "Strong portfolio" }

###

# Notes and tags from the hiring team; tags compare ignoring case.
POST {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/notes
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "note": "Ask about the notice period." }

###

POST {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/tags
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "tag": "referral" }

###

DELETE {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/tags?tag=referral
X-XSRF-TOKEN: {{xsrf}}

###

# Scorecards: one per reviewer per stage; submitting raises the ReviewerDecision trigger.
GET {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/scorecards

###

POST {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/scorecards
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "stageId": "interview", "ratings": [{ "criterionId": "role_skills", "rating": "Demonstrated" }], "recommendation": "Yes" }

###

# My tasks: the signed-in person's and the team's open tasks (status=Completed, scope=Everyone widen it).
GET {{api}}/v1/tasks?status=Open&scope=Mine

###

POST {{api}}/v1/tasks/00000000-0000-0000-0000-000000000000/complete
X-XSRF-TOKEN: {{xsrf}}

###

GET {{api}}/v1/schemas/hiring-template-definition.json
Accept: application/schema+json

###

# The organization: any member reads it; Owners and Admins rename it. The slug never changes.
GET {{api}}/v1/organization

###

PUT {{api}}/v1/organization
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "name": "Brightwater Studio" }

###

# Team: members, invitations and the membership log (Owners and Admins manage; every member reads the list).
GET {{api}}/v1/organization/members

###

POST {{api}}/v1/organization/invitations
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "email": "new.teammate@example.com", "role": "Recruiter" }

###

PUT {{api}}/v1/organization/members/00000000-0000-0000-0000-000000000000/role
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "role": "Viewer" }

###

DELETE {{api}}/v1/organization/members/00000000-0000-0000-0000-000000000000
X-XSRF-TOKEN: {{xsrf}}

###

GET {{api}}/v1/organization/invitations

###

DELETE {{api}}/v1/organization/invitations/00000000-0000-0000-0000-000000000000
X-XSRF-TOKEN: {{xsrf}}

###

GET {{api}}/v1/organization/membership-log

###

# The token comes from the emailed link's #invitation= fragment.
POST {{api}}/v1/auth/invitations/accept
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "token": "paste-the-token-here" }

###

GET {{api}}/v1/auth/organizations

###

POST {{api}}/v1/auth/switch-organization
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "organizationId": "00000000-0000-0000-0000-000000000000" }

###

# Slack (docs/architecture/slack.md): the member's view, and the channel picker for someone who manages integrations.
GET {{api}}/v1/slack

###

GET {{api}}/v1/slack/channels

###

PUT {{api}}/v1/slack/channel
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "channelId": "C0SBHIRING", "events": ["ApplicationSubmitted", "JobPublished"] }

###

PUT {{api}}/v1/slack/account
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "mentions": true, "tasks": false }

###

# Sandbox mode only: what the local sandbox workspace received.
GET {{api}}/v1/slack/sandbox/messages
