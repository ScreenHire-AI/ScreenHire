@api = http://localhost:5080

GET {{api}}/v1/public/organizations/brightwater/jobs
Accept: application/json

###

GET {{api}}/v1/jobs
Accept: application/json

###

GET {{api}}/v1/meta
Accept: application/json

###

# The dashboard routes below need a signed-in session cookie, and the POSTs and PUTs also need the antiforgery header
# (X-XSRF-TOKEN, the value of the XSRF-TOKEN cookie). Sign in through the dashboard first and copy both.
@xsrf = paste-the-XSRF-TOKEN-cookie-here

GET {{api}}/v1/templates
Accept: application/json

###

POST {{api}}/v1/jobs
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "title": "Platform Engineer",
  "templateVersionId": "0199e8a0-0000-7000-8000-000000000101",
  "applicantLocationRequirements": ["GB", "IE"],
  "salary": { "min": 70000, "max": 90000, "currency": "GBP" }
}

###

# Replace the ids with ones from the responses above.
POST {{api}}/v1/jobs/00000000-0000-0000-0000-000000000000/publish
X-XSRF-TOKEN: {{xsrf}}

###

POST {{api}}/v1/jobs/00000000-0000-0000-0000-000000000000/applications
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "candidate": { "fullName": "Jordan Example", "email": "jordan@example.com" },
  "accommodationRequested": false,
  "aiUseDeclaration": "DidNotUse"
}

###

POST {{api}}/v1/applications/00000000-0000-0000-0000-000000000000/move
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "toStageId": "screening", "note": "Strong portfolio" }

###

GET {{api}}/v1/schemas/hiring-template-definition.json
Accept: application/schema+json

###

# Team: members, invitations and the membership log (Owners and Admins manage; every member reads the list).
GET {{api}}/v1/organization/members

###

POST {{api}}/v1/organization/invitations
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "email": "new.teammate@example.com", "role": "Recruiter" }

###

PUT {{api}}/v1/organization/members/00000000-0000-0000-0000-000000000000/role
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "role": "Viewer" }

###

DELETE {{api}}/v1/organization/members/00000000-0000-0000-0000-000000000000
X-XSRF-TOKEN: {{xsrf}}

###

GET {{api}}/v1/organization/invitations

###

DELETE {{api}}/v1/organization/invitations/00000000-0000-0000-0000-000000000000
X-XSRF-TOKEN: {{xsrf}}

###

GET {{api}}/v1/organization/membership-log

###

# The token comes from the emailed link's #invitation= fragment.
POST {{api}}/v1/auth/invitations/accept
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "token": "paste-the-token-here" }

###

GET {{api}}/v1/auth/organizations

###

POST {{api}}/v1/auth/switch-organization
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{ "organizationId": "00000000-0000-0000-0000-000000000000" }
