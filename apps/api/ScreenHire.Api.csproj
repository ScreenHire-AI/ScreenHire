<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Build-time OpenAPI document: packages/api-client/openapi.json feeds the Orval TS client generator. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../packages/api-client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenHire.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenHire.ServiceDefaults\ScreenHire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\ScreenHire.Infrastructure\ScreenHire.Infrastructure.csproj" />
  </ItemGroup>

</Project>
