<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Build-time OpenAPI document: packages/api-client/openapi.json feeds the Orval TS client generator. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../packages/api-client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenHire.UnitTests" />
  </ItemGroup>

  <!-- Heading fonts (docs/architecture/branding.md section 3): the Rounded and Slab lists from Google's tags
       (scripts/heading-font-styles.mjs) and the sandbox catalogue's fonts, read from the assembly rather than shipped
       as content files. -->
  <ItemGroup>
    <Content Remove="Fonts\**" />
    <None Remove="Fonts\**" />
    <EmbeddedResource Include="Fonts\google-font-styles.json" LogicalName="HeadingFonts.google-font-styles.json" />
    <EmbeddedResource Include="Fonts\Sandbox\*" LogicalName="HeadingFonts.Sandbox.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenHire.ServiceDefaults\ScreenHire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\ScreenHire.Application\ScreenHire.Application.csproj" />
  </ItemGroup>

</Project>
