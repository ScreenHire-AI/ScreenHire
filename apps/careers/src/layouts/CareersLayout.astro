---
import '../styles/global.css';
import type { PublicBranding } from '@screenhire/api-client';
import { brandStylesheet } from '../lib/brand';

interface Props {
  title: string;
  description: string;
  organizationName: string;
  organizationSlug: string;
  /** The employer's palette; ScreenHire's default when null. */
  branding?: PublicBranding | null;
  /** Keeps search engines off pages that are one candidate's, such as a form step. */
  noindex?: boolean;
}

const { title, description, organizationName, organizationSlug, branding, noindex = false } = Astro.props;
const base = Astro.locals.hostTenant ? '' : `/${organizationSlug}`;
const brand = branding ? brandStylesheet(branding) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {brand && <link rel="stylesheet" href={`${base}/brand/${brand.hash}.css`} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-candidate-background text-candidate-foreground">
    <header class="border-b border-candidate-border">
      <div class="mx-auto flex h-15 max-w-3xl items-center justify-between px-5">
        <a href={base || '/'} class="flex items-center gap-2.5 font-bold text-candidate-foreground no-underline">
          <span
            aria-hidden="true"
            class="grid size-8 place-items-center rounded-full bg-candidate-cta font-display font-extrabold text-candidate-cta-foreground"
          >
            {organizationName.charAt(0)}
          </span>
          {organizationName}
        </a>
        <a href={base || '/'} class="text-sm font-semibold text-candidate-foreground">All jobs</a>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-8">
      <slot />
    </main>
    <footer class="flex flex-col items-center gap-1 py-6 text-center text-[13px] text-candidate-muted-foreground">
      <p>A person at {organizationName} reviews every application.</p>
      <p class="font-mono text-[11px]">
        POWERED BY SCREENHIRE · <a href={`${base}/privacy`} class="text-candidate-muted-foreground underline">WHAT WE COLLECT AND WHY</a>
      </p>
    </footer>
  </body>
</html>
