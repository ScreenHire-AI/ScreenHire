---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  organizationName: string;
  organizationSlug: string;
}

const { title, description, organizationName, organizationSlug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-candidate-background text-candidate-foreground">
    <header class="border-b border-candidate-border">
      <div class="mx-auto flex h-15 max-w-3xl items-center justify-between px-5">
        <a href={`/${organizationSlug}`} class="flex items-center gap-2.5 font-bold text-candidate-foreground no-underline">
          <span class="grid size-8 place-items-center rounded-full bg-candidate-cta font-display font-extrabold text-candidate-cta-foreground">
            {organizationName.charAt(0)}
          </span>
          {organizationName}
        </a>
        <a href={`/${organizationSlug}`} class="text-sm font-semibold text-candidate-foreground">All jobs</a>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-8">
      <slot />
    </main>
    <footer class="py-6 text-center text-[13px] text-candidate-muted-foreground">
      <p>A person at {organizationName} reviews every application.</p>
      <p class="font-mono text-[11px]">POWERED BY SCREENHIRE</p>
    </footer>
  </body>
</html>
