---
import '../styles/global.css';
import type { PublicBranding } from '@screenhire/api-client';
import EmbedFrame from '../components/EmbedFrame.astro';
import { brandImagePath, brandStylesheet } from '../lib/brand';
import { embedOf, withEmbed } from '../lib/embed';
import { basePath } from '../lib/host';

interface Props {
  title: string;
  description: string;
  organizationName: string;
  organizationSlug: string;
  /** The employer's branding (docs/architecture/branding.md); ScreenHire's look for every part that is null. */
  branding?: PublicBranding | null;
  /** Keeps search engines off pages that are one candidate's, such as a form step. */
  noindex?: boolean;
}

const { title, description, organizationName, organizationSlug, branding, noindex = false } = Astro.props;
const base = basePath(Astro.request, organizationSlug);
const brand = branding ? brandStylesheet(branding) : null;
// Same-origin paths under the base for what the page draws (img-src 'self'); the sharing image is the API's absolute
// careers address, because a crawler reads og:image from another site.
const logo = branding?.logo ? { ...branding.logo, src: brandImagePath(base, branding.logo) } : null;
const favicon = branding?.favicon ? { ...branding.favicon, href: brandImagePath(base, branding.favicon) } : null;
const sharing = branding?.sharingImage ?? null;
// In the widget (docs/architecture/careers-widget.md) the page's own links keep it there, and the page sizes its frame.
const embed = embedOf(Astro.locals);
const home = withEmbed(base || '/', embed);
---

<!doctype html>
<html lang="en" data-embed-origin={embed ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {brand && <link rel="stylesheet" href={`${base}/brand/${brand.hash}.css`} />}
    {favicon && <link rel="icon" type={favicon.contentType} href={favicon.href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={organizationName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      sharing && (
        <>
          <meta property="og:image" content={sharing.url} />
          <meta property="og:image:type" content={sharing.contentType} />
          <meta property="og:image:width" content={String(sharing.width)} />
          <meta property="og:image:height" content={String(sharing.height)} />
          <meta property="og:image:alt" content={`Careers at ${organizationName}`} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <!-- In a frame the viewport is the frame, so a page at least the screen's height could never shrink it. -->
  <body class:list={['flex flex-col bg-candidate-background text-candidate-foreground', !embed && 'min-h-screen']}>
    <!-- The header band takes the second colour; everything in it uses the header's own text colour, focus rings
         included, which is white or ink at 4.5:1 on the band (ADR-0018). -->
    <header class="candidate-header border-b border-candidate-border bg-candidate-header text-candidate-header-foreground">
      <div class="mx-auto flex h-15 max-w-3xl items-center justify-between gap-4 px-5">
        <a href={home} class="flex min-w-0 items-center gap-2.5 font-bold text-candidate-header-foreground no-underline">
          {
            logo ? (
              <img src={logo.src} alt={organizationName} width={logo.width} height={logo.height} class="h-10 w-auto max-w-60 object-contain object-left" />
            ) : (
              <>
                <span
                  aria-hidden="true"
                  class="grid size-8 shrink-0 place-items-center rounded-full bg-candidate-cta font-display font-extrabold text-candidate-cta-foreground"
                >
                  {organizationName.charAt(0)}
                </span>
                <span class="truncate">{organizationName}</span>
              </>
            )
          }
        </a>
        <a href={home} class="shrink-0 text-sm font-semibold text-candidate-header-foreground">All jobs</a>
      </div>
    </header>
    <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-8">
      <slot />
    </main>
    <footer class="flex flex-col items-center gap-1 py-6 text-center text-[13px] text-candidate-muted-foreground">
      <p>A person at {organizationName} reviews every application.</p>
      <p class="font-mono text-[11px]">
        POWERED BY SCREENHIRE · <a href={withEmbed(`${base}/privacy`, embed)} class="text-candidate-muted-foreground underline">WHAT WE COLLECT AND WHY</a>
      </p>
    </footer>
    {embed && <EmbedFrame />}
  </body>
</html>
