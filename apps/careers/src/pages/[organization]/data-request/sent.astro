---
// Where asking for a link lands (POST, then redirect, then this GET), so a refresh never posts twice and the address
// carries nothing about the candidate. The answer is fixed: it reads the same whether or not the address applied, and
// never says whether it was found (docs/architecture/data-requests.md).
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { getPublicOrganization } from '../../../lib/api';
import { basePath } from '../../../lib/host';

const { organization } = Astro.params;
const response = await getPublicOrganization(organization!);
if (response.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = response.data;
const base = basePath(Astro.request, employer.slug);
---

<CareersLayout
  title={`Check your email | ${employer.name}`}
  description={`What happens after you ask ${employer.name} about your data.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-3xl leading-tight font-bold tracking-tight">Check your email</h1>
  <p class="mt-3 text-candidate-body">
    If we have an application from that address, we have emailed a link. It works for about an hour, and only for you.
  </p>
  <p class="mt-3 text-candidate-body text-candidate-muted-foreground">
    The email can take a few minutes, and may land in your spam folder. If nothing arrives, write to {employer.name} through the
    email address they use to write to you.
  </p>
  <p class="mt-6 text-sm">
    <a href={`${base}/privacy`} class="text-link">What we collect and why</a>
  </p>
  <a href={base || '/'} class="button-secondary mt-4">See open roles</a>
</CareersLayout>
