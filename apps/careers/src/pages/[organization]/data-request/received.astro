---
// Where choosing a copy or erasure lands (POST, then redirect, then this GET). Token-free: the emailed link stays in the
// candidate's inbox, and the page does not say which of the two they chose, so it says what happens for each.
import Panel from '../../../components/Panel.astro';
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { getPublicOrganization } from '../../../lib/api';
import { basePath } from '../../../lib/host';

const { organization } = Astro.params;
const response = await getPublicOrganization(organization!);
if (response.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = response.data;
const base = basePath(Astro.request, employer.slug);
---

<CareersLayout
  title={`We have your request | ${employer.name}`}
  description={`What happens next after you ask ${employer.name} about your data.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-candidate-title">We have your request</h1>
  <p class="mt-3 text-candidate-body">The hiring team at {employer.name} will see it and decide how to answer.</p>

  <Panel id="next" title="What happens next" class="mt-6">
    <ul class="flex list-disc flex-col gap-2 pl-5 text-candidate-body">
      <li>
        If you asked for a copy, we email a link to the file when it is ready. The link works for a limited time, so download
        the file when it arrives.
      </li>
      <li>
        If you asked for erasure and it goes ahead, we cannot email you afterwards, because your email address is erased too.
        You will not get a message when it is done.
      </li>
    </ul>
  </Panel>

  <a href={base || '/'} class="button-secondary mt-4">See open roles</a>
</CareersLayout>
