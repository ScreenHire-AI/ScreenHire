---
// Where an emailed data request link that no longer works lands: expired, damaged, or for a copy that is gone. Token-free,
// so the download endpoint can send people here without putting the link in the address.
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { getPublicOrganization } from '../../../lib/api';
import { basePath } from '../../../lib/host';

const { organization } = Astro.params;
const response = await getPublicOrganization(organization!);
if (response.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = response.data;
const base = basePath(Astro.request, employer.slug);
---

<CareersLayout
  title={`This link has expired or is not valid | ${employer.name}`}
  description={`A link about your data at ${employer.name} that no longer works.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-3xl leading-tight font-bold tracking-tight">This link has expired or is not valid</h1>
  <p class="mt-3 text-candidate-body text-candidate-muted-foreground">
    Links about your data stop working after a short time, and a copy of your data is available for a limited time. You can ask
    for a new link.
  </p>
  <a href={`${base}/data-request`} class="button-primary mt-4">Ask for a new link</a>
  <p class="mt-6 text-sm">
    <a href={`${base}/privacy`} class="text-link">What we collect and why</a>
  </p>
</CareersLayout>
