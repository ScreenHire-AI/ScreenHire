---
import JobFacts from '../../components/JobFacts.astro';
import CareersLayout from '../../layouts/CareersLayout.astro';
import { listPublicJobs } from '../../lib/api';
import { useEmbedding, withEmbed } from '../../lib/embed';
import { basePath } from '../../lib/host';

// On a tenant host the middleware rewrites `/` here; otherwise the organization is in the path (lib/tenancy.ts).
const { organization } = Astro.params;
const response = await listPublicJobs(organization!);

if (response.status !== 200) {
  return new Response(null, { status: 404 });
}

const board = response.data;
const base = basePath(Astro.request, board.organizationSlug);
const embed = useEmbedding(Astro.locals, Astro.url, board.embedOrigins);
---

<CareersLayout
  title={`Jobs at ${board.organizationName}`}
  description={`Open roles at ${board.organizationName}.`}
  organizationName={board.organizationName}
  organizationSlug={board.organizationSlug}
  branding={board.branding}
>
  <h1 class="font-display text-candidate-title">Open roles at {board.organizationName}</h1>
  {
    board.jobs.length === 0 ? (
      <p class="mt-3 text-candidate-body text-candidate-muted-foreground">
        There are no open roles right now. New roles appear here as soon as they open.
      </p>
    ) : (
      <>
        <p class="mt-2 text-candidate-body text-candidate-muted-foreground">
          {board.jobs.length} {board.jobs.length === 1 ? 'role is' : 'roles are'} open. Choose one to read it and apply.
        </p>
        <ul class="mt-6 flex flex-col gap-3">
          {board.jobs.map((job) => (
            <li>
              <a
                href={withEmbed(`${base}/jobs/${job.slug}`, embed)}
                class="flex flex-col gap-2 rounded-panel border border-candidate-border bg-candidate-surface p-5 text-candidate-foreground no-underline shadow-surface hover:border-candidate-input-border"
              >
                <span class="font-display text-panel-title">{job.title}</span>
                <JobFacts job={job} />
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</CareersLayout>
