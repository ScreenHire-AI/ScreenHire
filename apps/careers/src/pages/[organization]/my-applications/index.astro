---
// Where a candidate asks for the link to their own page (docs/architecture/candidate-portal.md): one email field. We email a
// link to the address if we have an application from it. One native form posted to the `requestPortalLink` action, so it works
// with JavaScript off. The only script is Cloudflare's bot check, when the deployment has one. The answer is the same fixed
// page whether or not the address applied (`sent`). Nothing on it collects anything about the browser.
import { actions } from 'astro:actions';
import Notice from '../../../components/Notice.astro';
import Panel from '../../../components/Panel.astro';
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { getPublicOrganization, getPublicPortalForm } from '../../../lib/api';
import { forwardedFor } from '../../../lib/apply-server';
import { basePath } from '../../../lib/host';
import { LINK_MESSAGES, MAX_EMAIL } from '../../../lib/portal';
import { TextField } from '@screenhire/ui/questions';

const { organization } = Astro.params;
const base = basePath(Astro.request, organization!);
const result = Astro.getActionResult(actions.requestPortalLink);
if (result?.data?.outcome === 'sent') {
  return Astro.redirect(`${base}/my-applications/sent`, 303);
}

// A post puts the address the candidate typed back into the page.
Astro.response.headers.set('Cache-Control', 'no-store');

const [employerResponse, formResponse] = await Promise.all([
  getPublicOrganization(organization!),
  getPublicPortalForm(organization!, forwardedFor(Astro.clientAddress)),
]);
if (employerResponse.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = employerResponse.data;
// Anything but a 200 (a busy network included) shows the page without the form: the way to reach the team is the same.
const form = formResponse.status === 200 ? formResponse.data : null;
const enabled = form?.enabled === true;
const turnstileSiteKey = enabled ? form!.turnstileSiteKey : null;
if (turnstileSiteKey) {
  Astro.csp?.insertScriptResource('https://challenges.cloudflare.com');
  Astro.csp?.insertDirective('frame-src https://challenges.cloudflare.com');
}

const outcome = result?.data?.outcome;
// A post that went through has already redirected, so what is left is a problem.
const problem = result?.error ? LINK_MESSAGES.error : outcome ? LINK_MESSAGES[outcome] : undefined;
const emailProblem = outcome === 'bad-email' ? problem : undefined;
const formProblem = emailProblem ? undefined : problem;
---

<CareersLayout
  title={`Your applications | ${employer.name}`}
  description={`See where your applications to ${employer.name} stand and read your messages.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-candidate-title">Your applications</h1>

  {
    !enabled && (
      <>
        <p class="mt-3 text-candidate-body">
          This page is not available right now. To reach the team at {employer.name}, reply to the last email they sent you.
        </p>
      </>
    )
  }

  {
    enabled && (
      <>
        <p class="mt-3 text-candidate-body">
          See where your applications to {employer.name} stand, finish one you saved, and read or answer messages from the team.
          There is no account and no password.
        </p>

        <Panel id="how" title="How it works" class="mt-6">
          <ol class="flex list-decimal flex-col gap-2 pl-5 text-candidate-body">
            <li>
              Enter the email address you applied with. If we have an application from that address, we email it a link. This page
              does not say whether we found one.
            </li>
            <li>The link opens your page. It works for a limited time, and only for you.</li>
            <li>Every email we send you about an application ends with a link to the same page.</li>
          </ol>
          <p class="mt-4 text-candidate-hint text-candidate-muted-foreground">
            We use the address you type here only to look for your applications and to send the link. This page collects nothing about
            your browser.
            {turnstileSiteKey && ' The bot check below is from Cloudflare, which sees your network address and browser.'}
          </p>
        </Panel>

        <form method="POST" action={actions.requestPortalLink} novalidate class="mt-6 flex flex-col gap-4" aria-labelledby="request-heading">
          <h2 id="request-heading" class="sr-only">Email me a link</h2>
          <input type="hidden" name="organization" value={employer.slug} />
          {formProblem && <Notice kind="problem" message={formProblem} />}
          <TextField
            name="email"
            label="Email address"
            hint="The address you used to apply."
            type="email"
            inputmode="email"
            autocomplete="email"
            required
            maxlength={MAX_EMAIL}
            value={result?.data?.email ?? ''}
            error={emailProblem}
          />

          {turnstileSiteKey && (
            <>
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
              <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
              <p class="text-candidate-hint text-candidate-muted-foreground">
                The bot check needs JavaScript. If you cannot run it, reply to the last email {employer.name} sent you.
              </p>
            </>
          )}

          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <button type="submit" class="button-primary">Email me a link</button>
          </div>
        </form>

        <p class="mt-6 text-candidate-body text-candidate-muted-foreground">
          Cannot use this page? Reply to the last email {employer.name} sent you.
        </p>
      </>
    )
  }
</CareersLayout>
