---
// Where stopping lands (POST, then redirect, then this GET), so a refresh never posts twice and the address carries no
// token: the link stays in the candidate's email.
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { getPublicOrganization } from '../../../lib/api';
import { basePath } from '../../../lib/host';

const { organization } = Astro.params;
const response = await getPublicOrganization(organization!);
if (response.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = response.data;
const base = basePath(Astro.request, employer.slug);
---

<CareersLayout
  title={`Details no longer kept | ${employer.name}`}
  description={`${employer.name} no longer keeps your details for future roles.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-3xl leading-tight font-bold tracking-tight">Done</h1>
  <p class="mt-3 text-candidate-body">
    {employer.name} no longer keeps your details for future roles, and will not invite you to apply for other roles.
  </p>
  <p class="mt-6 text-sm">
    <a href={`${base}/privacy`} class="text-link">What we collect and why</a>
  </p>
  <a href={base || '/'} class="button-secondary mt-4">See open roles</a>
</CareersLayout>
