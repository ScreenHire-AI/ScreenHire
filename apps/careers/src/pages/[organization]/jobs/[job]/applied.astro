---
// Where a submitted application lands (POST, then redirect, then this GET), so a refresh never sends it twice. It holds
// nothing about the candidate, and reads the same whether this was a new application or one already on file.
import Panel from '../../../../components/Panel.astro';
import CareersLayout from '../../../../layouts/CareersLayout.astro';
import { getPublicJob, getPublicOrganization } from '../../../../lib/api';
import { useEmbedding, withEmbed } from '../../../../lib/embed';
import { basePath } from '../../../../lib/host';

const { organization, job: jobSlug } = Astro.params;
const [organizationResponse, jobResponse] = await Promise.all([getPublicOrganization(organization!), getPublicJob(organization!, jobSlug!)]);
if (organizationResponse.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = organizationResponse.data;
const base = basePath(Astro.request, employer.slug);
const embed = useEmbedding(Astro.locals, Astro.url, employer.embedOrigins);
// The job may have closed since; the confirmation stands either way.
const jobTitle = jobResponse.status === 200 ? jobResponse.data.title : null;
---

<CareersLayout
  title={`Application sent | ${employer.name}`}
  description={`Your application to ${employer.name} was sent.`}
  organizationName={employer.name}
  organizationSlug={employer.slug}
  branding={employer.branding}
  noindex
>
  <h1 class="font-display text-candidate-title">Application sent</h1>
  <p class="mt-3 text-candidate-body">
    Thank you for applying{jobTitle && <> for <strong>{jobTitle}</strong></>} at {employer.name}. We have your application.
  </p>

  <Panel id="next-heading" title="What happens next" class="mt-6">
    <ul class="flex list-disc flex-col gap-2 pl-5 text-candidate-body">
      <li>{employer.name} reviews your application. Our checks for bots and impersonation never reject anyone.</li>
      <li>{employer.name} contacts you by email about next steps.</li>
      <li>
        See where your application stands and read your messages on <a href={withEmbed(`${base}/my-applications`, embed)} class="text-link">your page</a>.
      </li>
      <li>You can ask {employer.name} to show, correct or delete your information, or to have a person review your application. Use the address they write to you from.</li>
    </ul>
  </Panel>

  <a href={withEmbed(base || '/', embed)} class="button-secondary mt-4">See other open roles</a>
</CareersLayout>
