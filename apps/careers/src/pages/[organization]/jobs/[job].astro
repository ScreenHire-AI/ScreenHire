---
import JobUnavailable from '../../../components/JobUnavailable.astro';
import PrivacyNotice from '../../../components/PrivacyNotice.astro';
import CareersLayout from '../../../layouts/CareersLayout.astro';
import { formatSalary, getPublicJob, getPublicOrganization, jsonLdScript, label } from '../../../lib/api';
import { newTabLinks, useEmbedding, withEmbed } from '../../../lib/embed';
import { basePath } from '../../../lib/host';
import { buildJobPosting } from '../../../lib/job-posting';

const { organization, job: jobSlug } = Astro.params;
const [jobResponse, organizationResponse] = await Promise.all([
  getPublicJob(organization!, jobSlug!),
  getPublicOrganization(organization!),
]);

if (organizationResponse.status !== 200) {
  return new Response(null, { status: 404 });
}

const employer = organizationResponse.data;
const base = basePath(Astro.request, employer.slug);
const embed = useEmbedding(Astro.locals, Astro.url, employer.embedOrigins);

// A closed job is 410 Gone (teardown, docs/architecture/job-distribution.md), so search engines drop it for good
// (ADR-0003). The API still sends its last content with validThrough set to when it closed, so the page keeps its
// JSON-LD and Google reads the posting as expired. A draft or unknown job is 404.
const job = jobResponse.status === 200 || jobResponse.status === 410 ? jobResponse.data : null;
const closed = jobResponse.status === 410;
if (jobResponse.status !== 200) {
  Astro.response.status = closed ? 410 : 404;
}

// URLs from the API's domain configuration, so the canonical URL is the one feeds, boards and Google use. A job's URL
// is its board's URL plus /jobs/{slug} (DomainOptions.CareersJobUrl).
const posting = job
  ? jsonLdScript(
      buildJobPosting(job, {
        organizationName: employer.name,
        boardUrl: job.url.slice(0, job.url.lastIndexOf('/jobs/')),
        url: job.url,
        logoUrl: employer.branding.logo?.url,
      }),
    )
  : '';
const salary = job ? formatSalary(job.salaryMin, job.salaryMax, job.salaryCurrency) : null;
---

{
  (!job || closed) && (
    <JobUnavailable organization={employer} gone={closed}>
      {posting && <script slot="head" type="application/ld+json" is:inline set:html={posting} />}
    </JobUnavailable>
  )
}
{
  job && !closed && (
    <CareersLayout
      title={`${job.title} | ${employer.name}`}
      description={`${job.title} at ${employer.name}. ${job.location}.`}
      organizationName={employer.name}
      organizationSlug={employer.slug}
      branding={employer.branding}
    >
      <link slot="head" rel="canonical" href={job.url} />
      <script slot="head" type="application/ld+json" is:inline set:html={posting} />

      <h1 class="font-display text-3xl leading-tight font-bold tracking-tight">{job.title}</h1>
      <div class="mt-3 flex flex-wrap gap-1.5 text-[13px] font-semibold text-candidate-chip-foreground">
        <span class="rounded-full bg-candidate-chip px-2.5 py-1">{job.location}</span>
        <span class="rounded-full bg-candidate-chip px-2.5 py-1">{label(job.workplaceType)}</span>
        <span class="rounded-full bg-candidate-chip px-2.5 py-1">{label(job.employmentType)}</span>
        {salary && <span class="rounded-full bg-candidate-chip px-2.5 py-1">{salary}</span>}
      </div>

      {job.description && (
        <section
          aria-label="About the role"
          class="mt-6 text-[15px] leading-relaxed [&_a]:underline [&_h2]:mt-5 [&_h2]:text-lg [&_h2]:font-bold [&_h3]:mt-4 [&_h3]:font-bold [&_li]:mt-1 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-3 [&_ul]:list-disc [&_ul]:pl-5"
          set:html={embed ? newTabLinks(job.description) : job.description}
        />
      )}

      <div class="mt-6">
        <PrivacyNotice base={base} />
      </div>

      <a href={withEmbed(`${base}/jobs/${job.slug}/apply`, embed)} class="button-primary mt-6 w-full sm:w-auto">
        Apply for this role
      </a>
    </CareersLayout>
  )
}
