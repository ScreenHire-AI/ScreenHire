---
import { stepLabels, type Step } from '../lib/apply';

interface Props {
  steps: Step[];
  current: Step;
}

const { steps, current } = Astro.props;
const index = steps.indexOf(current);
---

<nav aria-label="Application steps" class="flex flex-col gap-1.5">
  <div aria-hidden="true" class="flex gap-1">
    {steps.map((_, i) => <span class:list={['h-1.5 flex-1 rounded-full', i <= index ? 'bg-candidate-cta' : 'bg-candidate-chip']} />)}
  </div>
  <ol class="flex justify-between gap-2 font-mono text-[11px] text-candidate-muted-foreground">
    {
      steps.map((step, i) => (
        <li aria-current={step === current ? 'step' : undefined} class:list={[step === current && 'font-semibold text-candidate-foreground']}>
          <span class="sr-only">
            Step {i + 1} of {steps.length}:
          </span>
          <span aria-hidden="true">{String(i + 1).padStart(2, '0')} </span>
          {stepLabels[step].toUpperCase()}
        </li>
      ))
    }
  </ol>
</nav>
