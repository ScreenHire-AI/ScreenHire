---
// How far along the apply form the candidate is (apply-flow.md §7): the shared progress bar and "40% done", rendered on
// the server with no JavaScript, the same component the dashboard's preview shows. The form's last step is always its
// review, which says "Ready to send". A line of progress, not navigation, so it is no landmark.
import { PageProgress } from '@screenhire/ui/questions';

interface Props {
  /** The current step, from 1. */
  step: number;
  steps: number;
}

const { step, steps } = Astro.props;
---

<div class="apply-progress">
  <PageProgress step={step} steps={steps} review={step === steps} />
</div>
