---
// One question, rendered by the shared question components (packages/ui), the same ones the dashboard's questionnaire
// preview shows. Rendered on the server only, so they ship no JavaScript, except file questions: those are FileField
// islands, which send files straight to storage once hydrated.
import type { PublicQuestion } from '@screenhire/api-client';
import { fileHintFor, QuestionField } from '@screenhire/ui/questions';
// Its own module, so the island's chunk holds the file field alone rather than every question component.
import FileField from '@screenhire/ui/questions/FileField.svelte';
import { fields, type ApplyState, type FieldErrors } from '../lib/apply';
import { basePath } from '../lib/host';

interface Props {
  question: PublicQuestion;
  state: ApplyState;
  errors: FieldErrors;
  organization: string;
  jobId: string;
  maxBytes: number;
}

const { question, state, errors, organization, jobId, maxBytes } = Astro.props;
---

{
  question.type === 'File' ? (
    <FileField
      client:load
      questionId={question.id}
      label={question.label}
      required={question.required}
      hint={fileHintFor(question, maxBytes)}
      accept={question.acceptedFileTypes ?? []}
      maxBytes={maxBytes}
      endpoint={`${basePath(Astro.request, organization)}/uploads`}
      jobId={jobId}
      current={state.files[question.id] ?? null}
      error={errors[fields.file(question.id)] ?? null}
    />
  ) : (
    <QuestionField question={question} answer={state.answers[question.id]} error={errors[fields.answer(question.id)] ?? null} />
  )
}
