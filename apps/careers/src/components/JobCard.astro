---
// A job on the board: its title, the short summary clamped to three lines, then at most three chips (place, type, pay).
// The clamp is CSS (`line-clamp-3`), so the page ships no script. The card uses the neutral candidate tokens only:
// employer colours reach a careers page through the brand stylesheet's CTA, brand-text and header tokens, and the
// card names none of them. Its title takes the employer's heading font like every careers title.
import JobFacts from './JobFacts.astro';

interface Props {
  job: Parameters<typeof JobFacts>[0]['job'] & { title: string; summary: string };
  href: string;
}

const { job, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-2 rounded-panel border border-candidate-border bg-candidate-surface p-5 text-candidate-foreground no-underline shadow-surface hover:border-candidate-input-border"
>
  <span class="font-display text-panel-title underline-offset-2 group-hover:underline group-focus-visible:underline">{job.title}</span>
  {job.summary && <span class="line-clamp-3 text-candidate-body text-candidate-muted-foreground">{job.summary}</span>}
  <JobFacts job={job} />
</a>
