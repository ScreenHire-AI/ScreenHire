---
import { fieldId } from '../lib/apply';

interface Props {
  name: string;
  label: string;
  value?: string | undefined;
  error?: string | undefined;
  hint?: string | null | undefined;
  required?: boolean;
  type?: 'text' | 'email' | 'tel' | 'url';
  inputmode?: 'text' | 'email' | 'tel' | 'url' | 'decimal' | undefined;
  autocomplete?: string;
  maxlength?: number | null | undefined;
  multiline?: boolean;
}

const { name, label, value = '', error, hint, required = false, type = 'text', inputmode, autocomplete, maxlength, multiline = false } =
  Astro.props;
const id = fieldId(name);
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm font-bold">
    {label}
    {!required && <span class="font-medium text-candidate-muted-foreground"> (optional)</span>}
  </label>
  {hint && <p id={`${id}-hint`} class="text-[13px] text-candidate-muted-foreground">{hint}</p>}
  {error && <p id={`${id}-error`} class="text-sm font-semibold text-destructive">{error}</p>}
  {
    multiline ? (
      <textarea
        id={id}
        name={name}
        required={required}
        maxlength={maxlength ?? undefined}
        aria-invalid={error ? 'true' : undefined}
        aria-describedby={describedBy}
        class="field-input"
        set:text={value}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        value={value}
        required={required}
        inputmode={inputmode}
        autocomplete={autocomplete}
        maxlength={maxlength ?? undefined}
        aria-invalid={error ? 'true' : undefined}
        aria-describedby={describedBy}
        class="field-input"
      />
    )
  }
</div>
