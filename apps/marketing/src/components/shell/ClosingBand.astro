---
// The dark band that closes a page: one sentence and one call to action (design system section 22).
import CtaLink from './CtaLink.astro';
import DarkBand from './DarkBand.astro';

interface Props {
  title: string;
  href: string;
  label?: string;
}

const { title, href, label = 'Start free trial' } = Astro.props;
---

<DarkBand labelledby="closing-title" class="flex flex-wrap items-center justify-between gap-x-12 gap-y-8">
  <h2 id="closing-title" class="max-w-xl font-display text-section text-balance">{title}</h2>
  <CtaLink href={href} size="lg">{label}</CtaLink>
</DarkBand>
