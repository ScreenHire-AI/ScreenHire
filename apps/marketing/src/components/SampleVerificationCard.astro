---
// The hero illustration: what a recruiter sees on a flagged application. Fictional applicant, evidence in plain words
// (the site never shows reason codes, docs/design/marketing-site.md). Status is its icon, colour and label (design
// system section 3.2).
import StatusBadge from './StatusBadge.astro';

// Kinds of thing a check looks at, in the plain words docs/design/marketing-site.md allows, never the signals themselves.
const evidence = ['The contact details they gave do not match each other.', 'One answer is the same text sent with other applications for this job.'];
const boards = ['Google for Jobs', 'Careers page'];
---

<figure class="flex min-w-0 flex-1 basis-[440px] flex-col gap-3">
  <div class="overflow-hidden rounded-panel border border-border bg-card shadow-surface">
    <div class="flex items-center gap-3 border-b border-border-subtle px-4 py-4">
      <span aria-hidden="true" class="grid size-10 place-items-center rounded-full bg-accent text-sm font-bold text-accent-foreground">JW</span>
      <div class="flex min-w-0 flex-1 flex-col">
        <span class="font-display text-lg font-bold">Jonas Weber</span>
        <span class="text-sm text-muted-foreground">Senior Product Designer, applied 3 hours ago</span>
      </div>
      <StatusBadge status="review" label="Review suggested" />
    </div>
    <ul class="flex flex-col gap-2 px-4 py-4 text-sm">
      {
        evidence.map((text) => (
          <li class="rounded-lg bg-secondary px-3 py-2 font-semibold">{text}</li>
        ))
      }
      <li class="mt-1 border-l-2 border-border pl-3 text-sm">
        <span class="font-semibold">Counter-evidence:</span> another detail on the application speaks for them.
      </li>
    </ul>
    <p class="border-t border-border-subtle bg-muted px-4 py-3 text-sm text-secondary-foreground">
      Two details do not add up, and one speaks for them. A person on your team decides.
      <span class="mt-1 block font-semibold text-foreground">Suggested next step: a short video call before the portfolio review.</span>
    </p>
  </div>
  <div class="ml-0 flex flex-wrap items-center overflow-hidden rounded-panel border border-border bg-card text-sm shadow-surface sm:ml-10">
    <span class="border-r border-border-subtle px-3 py-2 text-xs font-semibold text-muted-foreground">Posted to</span>
    {
      boards.map((board) => (
        <span class="inline-flex items-center gap-2 border-r border-border-subtle px-3 py-2 font-semibold last:border-r-0">
          {board}
          <StatusBadge status="open" label="Live" quiet />
        </span>
      ))
    }
  </div>
  <figcaption class="text-xs text-muted-foreground">Example applicant. Fictional data.</figcaption>
</figure>
