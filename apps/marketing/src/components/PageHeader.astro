---
// The top of an inner page: kicker, the page's one h1, and a lead paragraph.
interface Props {
  /** A line that adds to the breadcrumb above it. Leave it out when it would only repeat the page's name. */
  kicker?: string;
  title: string;
  lead?: string;
}

const { kicker, title, lead } = Astro.props;
---

<header class="mx-auto flex max-w-6xl flex-col gap-4 px-6 pt-10 pb-10">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1 class="max-w-4xl font-display text-4xl leading-[1.02] font-extrabold tracking-[-0.03em] sm:text-6xl">{title}</h1>
  {lead && <p class="max-w-2xl text-xl leading-relaxed text-secondary-foreground">{lead}</p>}
  <slot />
</header>
