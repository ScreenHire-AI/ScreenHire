---
import { Font, fontData } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteHeader from '../components/shell/SiteHeader.astro';
import { breadcrumbList, type Crumb, type JsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: JsonLd[];
  /** The trail after Home, ending with this page. Renders a visible trail and BreadcrumbList JSON-LD. */
  breadcrumbs?: Crumb[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** `dark` when the page opens with a dark hero band that the header sits on (design system section 22). */
  headerTone?: 'dark' | 'light';
}

const { title, description, jsonLd = [], breadcrumbs, ogType, noindex, headerTone = 'light' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const graph = breadcrumbs ? [breadcrumbList(breadcrumbs, site), ...jsonLd] : jsonLd;
// Preload only the latin body font (the first variant in astro.config.mjs); latin-ext downloads when a page needs it.
const bodyFont = fontData['--font-hanken']?.[0]?.src[0]?.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-hanken" />
    {bodyFont && <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />}
    <Font cssVariable="--font-bricolage" />
    <Font cssVariable="--font-jetbrains" />
    <Seo title={title} description={description} jsonLd={graph} ogType={ogType} noindex={noindex} />
    <Analytics />
  </head>
  <body class="min-h-screen bg-page text-foreground">
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground focus:not-sr-only focus:absolute focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <SiteHeader tone={headerTone} />
    {
      breadcrumbs && (
        <nav aria-label="Breadcrumb" class="mx-auto max-w-site px-4 md:px-6 lg:px-8">
          <ol class="flex flex-wrap gap-x-2 text-sm text-muted-foreground">
            <li>
              <a href="/" class="inline-flex min-h-6 items-center text-muted-foreground hover:text-primary pointer-coarse:min-h-11">Home</a>
            </li>
            {breadcrumbs.map((crumb, index) => (
              <li class="flex gap-x-2">
                <span aria-hidden="true">/</span>
                {index === breadcrumbs.length - 1 ? (
                  <span aria-current="page">{crumb.name}</span>
                ) : (
                  <a href={crumb.path} class="inline-flex min-h-6 items-center text-muted-foreground hover:text-primary pointer-coarse:min-h-11">
                    {crumb.name}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
