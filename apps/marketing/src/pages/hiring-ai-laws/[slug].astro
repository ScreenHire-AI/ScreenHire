---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import NotLegalAdvice from '../../components/NotLegalAdvice.astro';
import SourceList from '../../components/SourceList.astro';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageIntro from '../../components/shell/PageIntro.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages } from '../../lib/pages';
import { article, faqPage, formatDate } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const laws = await getCollection('laws');
  return laws.map((law) => ({ params: { slug: law.id }, props: { law } }));
}) satisfies GetStaticPaths;

interface Props {
  law: CollectionEntry<'laws'>;
}

const { law } = Astro.props;
const { Content } = await render(law);
const path = `${pages.laws.path}${law.id}/`;
const { title, description, faqs, published, lastReviewed } = law.data;
const site = Astro.site ?? new URL(Astro.url.origin);

const jsonLd = [
  article({ type: 'Article', headline: title, description, path, datePublished: published, dateModified: lastReviewed }, site),
  ...(faqs.length > 0 ? [faqPage(faqs)] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  breadcrumbs={[
    { name: pages.laws.label, path: pages.laws.path },
    { name: law.data.name, path },
  ]}
  jsonLd={jsonLd}
>
  <PageIntro title={title} lead={description}>
    <dl class="mt-2 flex flex-wrap gap-x-12 gap-y-3 text-base tabular-nums">
      <div>
        <dt class="font-bold">Where</dt>
        <dd class="text-muted-foreground">{law.data.jurisdiction}</dd>
      </div>
      <div>
        <dt class="font-bold">Last reviewed</dt>
        <dd class="text-muted-foreground"><time datetime={lastReviewed}>{formatDate(lastReviewed)}</time></dd>
      </div>
    </dl>
  </PageIntro>

  <div class="bg-page text-foreground">
    <div class="mx-auto max-w-site px-4 md:px-6 lg:px-8">
      <NotLegalAdvice lastReviewed={lastReviewed} />
    </div>
  </div>

  <Section class="grid gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,68ch)_minmax(16rem,22rem)] lg:justify-between">
    <article class="prose min-w-0">
      <Content />
    </article>
    <aside aria-labelledby="dates-title" class="flex min-w-0 flex-col gap-4 self-start tabular-nums">
      <h2 id="dates-title" class="font-display text-2xl font-bold">Key dates</h2>
      <p class="font-semibold">{law.data.status}</p>
      <ol class="flex flex-col">
        {
          law.data.keyDates.map((item) => (
            <li class="flex flex-col gap-1 border-t border-border py-3 last:border-b">
              <span class="font-semibold">{item.date}</span>
              <span class="text-pretty text-muted-foreground">{item.event}</span>
            </li>
          ))
        }
      </ol>
      <a href={pages.laws.path} class="mt-2 font-semibold text-primary underline underline-offset-4 hover:decoration-2">All laws in the tracker</a>
    </aside>
  </Section>

  <SourceList sources={law.data.sources} tone="band" />

  {faqs.length > 0 && <QuestionsList faqs={faqs} />}

  <ClosingBand title="Hire with a person in charge of every decision." />
</BaseLayout>
