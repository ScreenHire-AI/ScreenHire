---
import { getCollection } from 'astro:content';
import NotLegalAdvice from '../../components/NotLegalAdvice.astro';
import PageIntro from '../../components/shell/PageIntro.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages } from '../../lib/pages';
import { absoluteUrl, formatDate } from '../../lib/seo';

const { title, description, path, label } = pages.laws;
const site = Astro.site ?? new URL(Astro.url.origin);
const laws = (await getCollection('laws')).sort((a, b) => a.data.order - b.data.order);

const collectionPage = {
  '@type': 'CollectionPage',
  name: title,
  description,
  url: absoluteUrl(path, site),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: laws.map((law, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: law.data.title,
      url: absoluteUrl(`${path}${law.id}/`, site),
    })),
  },
};
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: label, path }]} jsonLd={[collectionPage]}>
  <PageIntro
    title="The laws that govern AI in hiring."
    lead="Plain-language summaries of the rules on automated tools in recruitment across the EU, the UK and the US, with key dates, sources and what is still unclear."
  >
    <NotLegalAdvice />
  </PageIntro>

  <Section tone="band" labelledby="laws-title" class="flex flex-col gap-8">
    <h2 id="laws-title" class="font-display text-band text-balance">Laws in the tracker</h2>
    <ul class="flex flex-col tabular-nums">
      {
        laws.map((law) => (
          <li class="grid items-baseline gap-x-12 gap-y-2 border-t border-border py-6 last:border-b lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)_12rem]">
            <div class="min-w-0">
              <h3 class="font-display text-2xl font-bold text-balance">
                <a href={`${path}${law.id}/`} class="text-foreground underline underline-offset-4 hover:decoration-2">{law.data.name}</a>
              </h3>
              <p class="mt-1 text-muted-foreground">{law.data.jurisdiction}</p>
            </div>
            <p class="text-pretty">{law.data.status}</p>
            <p class="text-sm text-muted-foreground lg:text-right">
              Reviewed <time datetime={law.data.lastReviewed}>{formatDate(law.data.lastReviewed)}</time>
            </p>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
