---
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageIntro from '../../components/shell/PageIntro.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/blog';
import { hero } from '../../lib/features';
import { pages } from '../../lib/pages';
import { absoluteUrl, formatDate, organizationId } from '../../lib/seo';

const { title, description, path, label } = pages.blog;
const site = Astro.site ?? new URL(Astro.url.origin);
const posts = await publishedPosts();

const blog = {
  '@type': 'Blog',
  name: 'ScreenHire blog',
  description,
  url: absoluteUrl(path, site),
  publisher: { '@id': organizationId(site) },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: absoluteUrl(`${path}${post.id}/`, site),
    datePublished: post.data.published,
  })),
};
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: label, path }]} jsonLd={[blog]}>
  <PageIntro title="Notes on hiring real people." lead={description}>
    <p><a href="/rss.xml" class="font-semibold text-primary underline underline-offset-4 hover:decoration-2">Subscribe with RSS</a></p>
  </PageIntro>

  <Section labelledby="posts-title">
    <h2 id="posts-title" class="sr-only">Posts</h2>
    <ul class="flex flex-col">
      {
        posts.map((post, index) => (
          <li class="grid gap-x-16 gap-y-2 border-t border-border py-8 last:border-b md:grid-cols-[10rem_minmax(0,1fr)]">
            <time datetime={post.data.published} class="text-muted-foreground tabular-nums">
              {formatDate(post.data.published)}
            </time>
            <div class="min-w-0">
              <h3 class:list={['font-display text-balance', index === 0 ? 'text-section' : 'text-2xl font-bold']}>
                <a href={`${path}${post.id}/`} class="text-foreground underline underline-offset-4 hover:decoration-2">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 max-w-measure text-pretty text-lg">{post.data.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <ClosingBand title={hero.headline} />
</BaseLayout>
