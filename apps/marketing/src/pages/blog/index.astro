---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/blog';
import { pages } from '../../lib/pages';
import { absoluteUrl, formatDate, organizationId } from '../../lib/seo';

const { title, description, path, label } = pages.blog;
const site = Astro.site ?? new URL(Astro.url.origin);
const posts = await publishedPosts();

const blog = {
  '@type': 'Blog',
  name: 'ScreenHire blog',
  description,
  url: absoluteUrl(path, site),
  publisher: { '@id': organizationId(site) },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: absoluteUrl(`${path}${post.id}/`, site),
    datePublished: post.data.published,
  })),
};
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: label, path }]} jsonLd={[blog]}>
  <PageHeader kicker="Blog" title="Notes on hiring real people." lead={description}>
    <p><a href="/rss.xml" class="font-semibold text-primary underline-offset-2 hover:underline">Subscribe with RSS</a></p>
  </PageHeader>
  <section aria-labelledby="posts-title" class="mx-auto max-w-6xl px-6 pb-16">
    <h2 id="posts-title" class="sr-only">Posts</h2>
    <ul class="flex flex-col gap-4">
      {
        posts.map((post) => (
          <li class="flex flex-col gap-2 rounded-xl border border-border bg-card p-6">
            <time datetime={post.data.published} class="font-mono text-xs text-muted-foreground uppercase">
              {formatDate(post.data.published)}
            </time>
            <h3 class="font-display text-2xl font-bold">
              <a href={`${path}${post.id}/`} class="text-foreground no-underline hover:text-primary">
                {post.data.title}
              </a>
            </h3>
            <p class="text-secondary-foreground">{post.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
