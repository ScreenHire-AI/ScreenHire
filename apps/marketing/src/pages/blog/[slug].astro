---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageIntro from '../../components/shell/PageIntro.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts } from '../../lib/blog';
import { hero } from '../../lib/features';
import { pages } from '../../lib/pages';
import { article, formatDate } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = Astro.site ?? new URL(Astro.url.origin);
const path = `${pages.blog.path}${post.id}/`;
const { title, description, published, updated } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  breadcrumbs={[
    { name: pages.blog.label, path: pages.blog.path },
    { name: title, path },
  ]}
  jsonLd={[article({ type: 'BlogPosting', headline: title, description, path, datePublished: published, dateModified: updated }, site)]}
>
  <PageIntro title={title} lead={description}>
    <p class="text-base text-muted-foreground">
      By the ScreenHire team on <time datetime={published}>{formatDate(published)}</time>.
      {updated && <> Updated <time datetime={updated}>{formatDate(updated)}</time>.</>}
    </p>
  </PageIntro>

  <Section label="Post">
    <article class="prose">
      <Content />
    </article>
  </Section>

  <ClosingBand title={hero.headline} />
</BaseLayout>
