---
// The comparison page template: every /compare/<id>/ page renders a `comparisons` entry, so adding "Breezy vs
// ScreenHire" means adding one YAML file whose every claim has its sources and the date it was read.
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Claim from '../../components/Claim.astro';
import SourceList from '../../components/SourceList.astro';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageIntro from '../../components/shell/PageIntro.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sellingPoints } from '../../lib/features';
import { pages } from '../../lib/pages';
import { faqPage, formatDate } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const comparisons = await getCollection('comparisons');
  return comparisons.map((comparison) => ({ params: { slug: comparison.id }, props: { comparison } }));
}) satisfies GetStaticPaths;

interface Props {
  comparison: CollectionEntry<'comparisons'>;
}

const { comparison } = Astro.props;
const data = comparison.data;
const path = `${pages.compare.path}${comparison.id}/`;
// The most recent day any claim was read, for the line under the title.
const lastRead = [...data.leftOpen.map((item) => item.theirs.asOf), ...data.rows.map((row) => row.theirs.asOf)].sort().at(-1)!;
const point = (id: string) => sellingPoints.find((candidate) => candidate.id === id)!;
---

<BaseLayout
  title={data.title}
  description={data.description}
  headerTone="dark"
  breadcrumbs={[
    { name: pages.compare.label, path: pages.compare.path },
    { name: `${data.competitor} alternative`, path },
  ]}
  jsonLd={data.faqs.length > 0 ? [faqPage(data.faqs)] : []}
>
  <PageIntro tone="dark" title={data.heading} lead={data.intro}>
    <p class="text-sm text-muted-foreground">
      {data.competitor} facts last read on <time datetime={lastRead}>{formatDate(lastRead)}</time>. Plans change, so check the sources.
    </p>
  </PageIntro>

  <Section labelledby="open-title" class="flex flex-col gap-10">
    <h2 id="open-title" class="max-w-3xl font-display text-section text-balance">What {data.competitor} leaves open</h2>
    <ul class="flex flex-col tabular-nums">
      {
        data.leftOpen.map((item) => (
          <li class="grid gap-x-16 gap-y-6 border-t border-border py-10 first:border-t-0 first:pt-0 md:grid-cols-2">
            <h3 class="max-w-3xl font-display text-2xl font-bold text-balance md:col-span-2">{point(item.point).title}</h3>
            <div class="min-w-0">
              <p class="font-bold">{data.competitor}</p>
              <div class="mt-2"><Claim text={item.theirs.text} sources={item.theirs.sources} asOf={item.theirs.asOf} /></div>
            </div>
            <div class="min-w-0">
              <p class="font-bold">ScreenHire</p>
              <p class="mt-2 text-pretty">{point(item.point).promise} {item.ours}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="band" labelledby="table-title" class="flex flex-col gap-10">
    <h2 id="table-title" class="max-w-3xl font-display text-section text-balance">Side by side</h2>
    <ul class="flex flex-col tabular-nums">
      {
        data.rows.map((row) => (
          <li class="grid gap-x-16 gap-y-4 border-t border-border py-6 last:border-b md:grid-cols-[10rem_minmax(0,1fr)_minmax(0,1fr)]">
            <h3 class="text-xl font-bold">{row.topic}</h3>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-muted-foreground">{data.competitor}</p>
              <div class="mt-1"><Claim text={row.theirs.text} sources={row.theirs.sources} asOf={row.theirs.asOf} /></div>
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-muted-foreground">ScreenHire</p>
              <p class="mt-1 text-pretty">{row.ours}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section labelledby="fit-title" class="flex flex-col gap-10">
    <h2 id="fit-title" class="max-w-3xl font-display text-section text-balance">Which fits your team</h2>
    <div class="grid gap-x-16 gap-y-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-bold">{data.competitor} may suit you if</h3>
        <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 marker:text-muted-foreground">
          {data.whenCompetitorFits.map((item) => <li class="text-pretty">{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-xl font-bold">ScreenHire may suit you if</h3>
        <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 marker:text-muted-foreground">
          {data.whenScreenHireFits.map((item) => <li class="text-pretty">{item}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <SourceList sources={data.sources} title={`Sources for ${data.competitor}`} tone="band" />

  {data.faqs.length > 0 && <QuestionsList faqs={data.faqs} />}

  <ClosingBand title="Try ScreenHire on your next hire." />
</BaseLayout>
