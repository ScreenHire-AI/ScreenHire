---
import { PUBLIC_APP_URL } from 'astro:env/server';
import ClosingBand from '../components/shell/ClosingBand.astro';
import CtaLink from '../components/shell/CtaLink.astro';
import DarkBand from '../components/shell/DarkBand.astro';
import PlanRows from '../components/shell/PlanRows.astro';
import QuestionsList from '../components/shell/QuestionsList.astro';
import Section from '../components/shell/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appLinks } from '../lib/app-links';
import { includedByTopic, pricingNotes } from '../lib/features';
import { pages } from '../lib/pages';
import { plans, pricedOffers, trialLabel, trialPlan } from '../lib/pricing';
import { faqPage, softwareApplication, type Faq } from '../lib/seo';

const { title, description, path, label } = pages.pricing;
const site = Astro.site ?? new URL(Astro.url.origin);
// Sign-up lives in the dashboard; until its URL is configured the buttons point at what every plan includes.
const startUrl = appLinks(PUBLIC_APP_URL, '#included').signUp;

const faqs: Faq[] = [
  {
    question: 'What counts as an open job?',
    answer: 'A published one. Drafts and closed jobs never count.',
  },
  {
    question: 'What happens at the limit?',
    answer: 'Open jobs stay open and everything keeps working. Close a job or change plan before you open another.',
  },
  {
    question: 'What happens after the trial?',
    answer: 'Nothing is deleted, and open jobs stay open. Choose a plan to keep opening jobs.',
  },
  {
    question: 'Can I change or cancel?',
    answer: "Any time. Your organization's Owner changes or cancels the plan from Billing. A cancelled plan runs to the end of the period you paid for.",
  },
  {
    question: 'Are prices before tax?',
    answer: 'Yes, tax is added where it applies. Checkout shows the amount before you pay.',
  },
  {
    question: 'How many users can I add?',
    answer: 'As many as you like. Every plan has unlimited users.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: label, path }]}
  headerTone="dark"
  jsonLd={[softwareApplication(description, site, pricedOffers(plans)), faqPage(faqs)]}
>
  <DarkBand labelledby="pricing-title" class="flex flex-wrap gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_22rem] flex-col items-start gap-4">
      <h1 id="pricing-title" class="font-display text-section text-balance">One price for your whole team. Everything included.</h1>
      <p class="max-w-measure text-xl text-pretty">
        Plans differ only in how many jobs you have open at once. Jobs already open stay open if you reach the limit.
      </p>
      <CtaLink href={startUrl} size="lg" class="mt-4">{trialLabel()}</CtaLink>
    </div>
    <div class="min-w-0 flex-[1_1_28rem]">
      <PlanRows trialPlan={trialPlan} />
    </div>
  </DarkBand>

  <Section id="included" labelledby="included-title" class="flex flex-wrap gap-x-16 gap-y-8">
    <div class="flex flex-[1_1_16rem] flex-col gap-4">
      <h2 id="included-title" class="font-display text-band text-balance">Every plan includes</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">Unlimited users, and every feature below.</p>
    </div>
    <div class="flex min-w-0 flex-[3_1_36rem] flex-col">
      {
        includedByTopic.map((topic) => (
          <div class="flex flex-wrap gap-x-8 gap-y-2 border-t border-border py-5 last:border-b">
            <h3 class="flex-[1_1_12rem] text-xl font-bold text-balance">{topic.title}</h3>
            <ul class="flex min-w-0 flex-[2_1_20rem] flex-col gap-2 text-secondary-foreground">
              {topic.items.map((item) => (
                <li class="max-w-measure text-pretty">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="band" labelledby="not-extra-title" class="flex flex-col gap-10">
    <div class="flex max-w-measure flex-col gap-4">
      <h2 id="not-extra-title" class="font-display text-section text-balance">What you will not pay extra for</h2>
      <p class="text-pretty text-secondary-foreground">
        Here is what three vendors' own pages list today, with the date we read each one.
      </p>
    </div>
    <ul class="flex flex-col">
      {
        pricingNotes.map((note) => (
          <li class="flex flex-wrap gap-x-16 gap-y-2 border-t border-border py-5 last:border-b">
            <p class="flex-[1_1_20rem] text-xl font-bold text-balance">{note.ours}</p>
            <p class="max-w-measure flex-[1_1_24rem] text-pretty tabular-nums text-secondary-foreground">
              {note.elsewhere}
              <span class="mt-1 block text-sm text-muted-foreground">
                Source: <a href={note.source.href} rel="noopener" class="inline-flex min-h-6 items-center text-primary underline underline-offset-4 hover:decoration-2 pointer-coarse:min-h-11">{note.source.label}</a>
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <QuestionsList faqs={faqs} title="Questions about plans" />

  <ClosingBand title="Spend your interviews on real candidates." href={startUrl} />
</BaseLayout>
