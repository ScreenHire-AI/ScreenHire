---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'ScreenHire — the hiring platform that knows who is really applying';
const description =
  'ScreenHire is an applicant tracking system for small teams that spots bots, impersonators and copy-paste applications — with plain-language evidence your team can read and a process candidates can trust.';

const features = [
  {
    kicker: '01 · Integrity',
    title: 'Evidence, not verdicts',
    body: "Every flag shows what was observed, why it matters and what counts in the candidate's favour — plus a suggested next step. Your team decides. Nothing is rejected automatically.",
  },
  {
    kicker: '02 · Distribution',
    title: 'Post everywhere. Remove everywhere.',
    body: 'Publish to your careers page, Google for Jobs and job boards in one click — and take it all down in one click, with honest status for every board.',
  },
  {
    kicker: '03 · Workflows',
    title: 'A workflow for every role',
    body: 'Build hiring templates once — stages, screening questions, automations — then tailor them per job. Everything is available through our API.',
  },
];

const laws = ['GDPR', 'UK GDPR', 'EU AI Act', 'NYC LL144', 'Illinois', 'Colorado', 'California ADMT'];

const softwareApplication = {
  '@type': 'SoftwareApplication',
  name: 'ScreenHire',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={[softwareApplication]}>
  <section aria-labelledby="hero-title" class="mx-auto max-w-6xl px-6 pt-14 pb-16">
    <p class="font-mono text-xs tracking-[0.1em] text-muted-foreground">APPLICANT INTEGRITY · APPLICANT TRACKING</p>
    <h1 id="hero-title" class="mt-4 max-w-3xl font-display text-5xl leading-[0.98] font-extrabold tracking-[-0.035em] sm:text-7xl">
      Know who's really applying.
    </h1>
    <p class="mt-5 max-w-xl text-xl leading-relaxed text-secondary-foreground">
      ScreenHire is the hiring platform that spots bots, impersonators and copy-paste applications — with evidence your
      team can read, and a process candidates can trust.
    </p>
    <div id="start" class="mt-7 flex flex-wrap gap-3">
      <a href="#product" class="inline-flex h-13 items-center rounded-xl bg-primary px-6 text-[17px] font-bold text-primary-foreground no-underline">Start hiring free</a>
      <a href="#integrity" class="inline-flex h-13 items-center rounded-xl border border-input bg-card px-6 text-[17px] font-bold text-foreground no-underline">See how detection works</a>
    </div>
    <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs text-muted-foreground">
      <span>NO CREDIT CARD</span><span>GDPR &amp; EU AI ACT READY</span><span>EVIDENCE, NEVER AUTO-REJECTION</span>
    </p>
  </section>

  <section id="product" aria-labelledby="features-title" class="mx-auto max-w-6xl px-6 py-16">
    <h2 id="features-title" class="max-w-2xl font-display text-4xl leading-tight font-bold tracking-tight">
      Everything a small team needs to hire real people, fast.
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        features.map((feature) => (
          <article class="flex flex-col gap-2.5 rounded-xl border border-border bg-card p-6">
            <span class="font-mono text-xs text-muted-foreground uppercase">{feature.kicker}</span>
            <h3 class="font-display text-2xl leading-snug font-bold">{feature.title}</h3>
            <p class="text-secondary-foreground">{feature.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="integrity" aria-labelledby="integrity-title" class="mx-auto max-w-6xl px-6 py-12">
    <h2 id="integrity-title" class="font-display text-3xl font-bold tracking-tight">Fair to candidates. Clear for recruiters.</h2>
    <p class="mt-3 max-w-2xl text-secondary-foreground">
      Candidates see exactly what we look at before they start — and can switch off typing signals if they use assistive
      technology. Recruiters get reasons and a suggested next step, not a black-box score.
    </p>
  </section>

  <section id="compliance" aria-labelledby="law-title" class="mx-auto mb-16 max-w-6xl px-6">
    <div class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border border-border bg-card p-7">
      <div class="flex flex-col gap-3">
        <h2 id="law-title" class="font-display text-3xl font-bold tracking-tight">Built for the laws you hire under</h2>
        <ul class="flex flex-wrap gap-1.5" aria-label="Regulations covered">
          {laws.map((law) => <li class="rounded-full bg-secondary px-2.5 py-1 font-mono text-xs uppercase">{law}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
