---
// The home page, in direction B + C (design system section 22, docs/design/marketing-site.md): a dark hero, three sourced
// numbers, the five selling points in the owner's order, pricing, questions and the close. Its words come from
// lib/features.ts, its prices from the plan catalogue, and its pictures from the captured screenshots. The hero's bold
// element is ApplicantPair (markup), not the captured flagged panel, which names the kinds of signal a check uses. The
// team's activity and the candidate's page are markup too. The workflow screenshot is left out, because the captured
// activity and workflow screens show a matching card, a rejection-review automation and a verification tag.
import { PUBLIC_APP_URL } from 'astro:env/server';
import templateStages from '../assets/product/template-stages.png';
import templateStagesPhone from '../assets/product/template-stages-phone.png';
import ApplicantPair from '../components/shell/ApplicantPair.astro';
import ClosingBand from '../components/shell/ClosingBand.astro';
import CtaLink from '../components/shell/CtaLink.astro';
import DarkBand from '../components/shell/DarkBand.astro';
import LevelChip from '../components/shell/LevelChip.astro';
import PlanRows from '../components/shell/PlanRows.astro';
import ProofList from '../components/shell/ProofList.astro';
import ProductFrame from '../components/shell/ProductFrame.astro';
import QuestionsList from '../components/shell/QuestionsList.astro';
import RuledList from '../components/shell/RuledList.astro';
import Section from '../components/shell/Section.astro';
import SellingPoint from '../components/shell/SellingPoint.astro';
import SourcedNumber from '../components/shell/SourcedNumber.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appLinks } from '../lib/app-links';
import { automation, hero, integrations, notPaidExtra, pricingNotes, sellingPoints } from '../lib/features';
import { pages } from '../lib/pages';
import { plans, pricedOffers, startingPrice, trialLabel, trialPlan } from '../lib/pricing';
import { faqPage, softwareApplication, type Faq } from '../lib/seo';

const { title, description } = pages.home;
const site = Astro.site ?? new URL(Astro.url.origin);
const { signUp } = appLinks(PUBLIC_APP_URL, pages.pricing.path);
const fromPrice = startingPrice(plans);

const [realPeople, neverGuessing, automate, integrationsPoint, builtYourWay] = sellingPoints;
const marketNote = (topic: string) => pricingNotes.find((note) => note.topic === topic);
const fraudNote = marketNote('real-people');
const automationNote = marketNote('automate-anything');

const faqs: Faq[] = [
  {
    question: 'Does ScreenHire reject people for me?',
    answer: 'Never on a check. A flag asks for a closer look, and a person on your team makes every decision.',
  },
  {
    question: 'Is it fair to candidates?',
    answer: 'Candidates are told what is collected before they start. Nothing reads faces, voices or feelings, and they can see where they stand.',
  },
  {
    question: 'How long does setup take?',
    answer: 'Start from a ready-made hiring template, add your branding and post your first job. There is nothing to install.',
  },
  {
    question: 'What happens when the trial ends?',
    answer: 'Choose a plan to keep opening jobs. Nothing is deleted, and open jobs stay open.',
  },
];

// What the team sees on a candidate. It is fictional, and each line is something the dashboard records (docs/status.md).
const activity = [
  { when: 'Today 09:12', what: 'Hannah replied: "Thursday at 10 works for me."' },
  { when: 'Yesterday', what: 'Avery emailed the interview times.' },
  { when: 'Yesterday', what: 'Jordan moved her to Interview with a note: "Strong portfolio."' },
  { when: 'Monday 14:30', what: 'Applied from your careers page.' },
];

// The same candidate on her own page: the four steps a candidate sees (docs/architecture/candidate-portal.md). It is
// markup rather than the captured portal, which draws too small to read beside the activity list.
const steps: { name: string; state: 'done' | 'current' | 'next' }[] = [
  { name: 'Applied', state: 'done' },
  { name: 'In review', state: 'done' },
  { name: 'Interview', state: 'current' },
  { name: 'Offer', state: 'next' },
];

const link = 'text-primary underline underline-offset-4 hover:decoration-2';
// A link on a line of its own is a 44px target on touch (design system F4), as the header and footer links are.
const standalone = `${link} inline-flex min-h-6 items-center pointer-coarse:min-h-11`;
---

<BaseLayout title={title} description={description} headerTone="dark" jsonLd={[softwareApplication(description, site, pricedOffers(plans)), faqPage(faqs)]}>
  <DarkBand labelledby="hero-title" class="flex flex-wrap items-center gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_26rem] flex-col items-start gap-6">
      <h1 id="hero-title" class="font-display text-display text-balance">{hero.headline}</h1>
      <p class="max-w-xl text-xl text-pretty">{hero.subline}</p>
      <div class="flex flex-wrap items-center gap-3">
        <CtaLink href={signUp} size="lg">{trialLabel()}</CtaLink>
        <CtaLink href={pages.pricing.path} variant="secondary" size="lg">See pricing</CtaLink>
      </div>
      {fromPrice && <p class="text-lg">From <span class="tabular-nums">{fromPrice}</span>&nbsp;a month for your whole team.</p>}
    </div>
    <div class="min-w-0 flex-[1_1_30rem]"><ApplicantPair /></div>
  </DarkBand>

  <Section tone="band" label="Why it matters" class="grid gap-x-16 gap-y-10 md:grid-cols-3">
    {realPeople!.figures.map((figure) => <SourcedNumber figure={figure} />)}
  </Section>

  <SellingPoint point={realPeople!}>
    <Fragment slot="words">
      <p class="max-w-measure text-pretty">Fraud checks are on every plan, not an extra.</p>
      {
        fraudNote && (
          <p class="max-w-measure text-pretty text-secondary-foreground">
            {fraudNote.elsewhere}{' '}
            <a href={fraudNote.source.href} rel="noopener" class={link}>{fraudNote.source.label}</a>.
          </p>
        )
      }
      <p><a href={realPeople!.pagePath} class={standalone}>{pages.realPeople.label}</a></p>
    </Fragment>
    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold">What you see</h3>
        <ProofList items={['A level for every applicant', 'The evidence behind it', 'What speaks for them', 'A suggested next step']} />
        <ul aria-label="Levels you may see" class="mt-2 flex flex-col items-start gap-2">
          <li><LevelChip level="noConcerns" /></li>
          <li><LevelChip level="reviewSuggested" /></li>
          <li><LevelChip level="verificationSuggested" /></li>
          <li><LevelChip level="someSignsOfAiHelp" /></li>
        </ul>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold">What ScreenHire never does</h3>
        <ProofList items={['Reject anyone on a check', 'Give a score or a percentage', 'Read faces, voices or feelings', 'Look people up on social media']} />
      </div>
    </div>
  </SellingPoint>

  <SellingPoint point={neverGuessing!} layout="stacked" tone="band">
    {neverGuessing!.figures.map((figure) => <SourcedNumber slot="words" figure={figure} class="mt-4 max-w-measure" />)}
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap gap-x-8 gap-y-10">
        <figure class="flex min-w-0 flex-[3_1_28rem] flex-col gap-3">
          <figcaption class="text-xl font-bold">What your team sees</figcaption>
          <ProductFrame>
            <p class="border-b border-border-subtle px-5 py-4 font-bold">Hannah Brooks, Product Designer</p>
            <ol class="flex flex-col px-5 pb-3">
              {
                activity.map((entry) => (
                  <li class="flex flex-wrap gap-x-4 gap-y-1 border-b border-border-subtle py-3 last:border-b-0">
                    <span class="flex-[0_1_7rem] text-muted-foreground">{entry.when}</span>
                    <span class="min-w-0 flex-[1_1_14rem] text-pretty">{entry.what}</span>
                  </li>
                ))
              }
            </ol>
          </ProductFrame>
        </figure>
        <figure class="flex min-w-0 flex-[2_1_20rem] flex-col gap-3">
          <figcaption class="text-xl font-bold">What the candidate sees</figcaption>
          <ProductFrame>
            <div class="flex flex-col gap-5 px-5 py-5">
              <p class="font-display text-xl font-semibold">Your applications</p>
              <p class="font-bold">Product Designer</p>
              <ol aria-label="Where Hannah stands" class="grid grid-cols-2 gap-x-6 gap-y-3">
                {
                  steps.map((step) => (
                    <li aria-current={step.state === 'current' ? 'step' : undefined} class:list={['flex items-center gap-2', step.state === 'current' ? 'font-bold' : step.state === 'next' && 'text-muted-foreground']}>
                      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={['size-5 shrink-0', step.state === 'done' ? 'text-status-clear-mark' : 'text-foreground']}>
                        <circle cx="12" cy="12" r="10" />
                        {step.state === 'done' && <path d="m16 9-5.5 5.5L8 12" />}
                        {step.state === 'current' && <circle cx="12" cy="12" r="4" fill="currentColor" />}
                      </svg>
                      {step.name}
                    </li>
                  ))
                }
              </ol>
              <p class="text-muted-foreground">Her messages with your team are on this page too, and she can reply.</p>
            </div>
          </ProductFrame>
        </figure>
      </div>
      <p class="text-sm text-muted-foreground">Sample candidate. The people and the company here are fictional.</p>
    </div>
  </SellingPoint>

  <SellingPoint point={automate!}>
    <Fragment slot="words">
      <p class="max-w-measure text-pretty">Each automation reads as When, If, Then. Test it on a sample application before it goes live. Every plan has all of it.</p>
      {
        automationNote && (
          <p class="max-w-measure text-pretty text-secondary-foreground">
            {automationNote.elsewhere}{' '}
            <a href={automationNote.source.href} rel="noopener" class={link}>{automationNote.source.label}</a>.
          </p>
        )
      }
    </Fragment>
    <div class="flex flex-col gap-8">
      <p class="dark rounded-panel bg-background px-6 py-6 font-display text-2xl font-semibold text-balance text-foreground md:px-8 md:py-8 md:text-3xl">
        {automation.sentence}
      </p>
      <ul class="flex flex-col">
        {
          automation.examples.map((example) => (
            <li class="flex flex-wrap gap-x-6 gap-y-1 border-t border-border py-4 last:border-b">
              <span class="flex-[0_1_11rem] font-bold">{example.scope}</span>
              <span class="min-w-0 flex-[1_1_16rem] text-pretty">{example.text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </SellingPoint>

  <SellingPoint point={integrationsPoint!} tone="band">
    <RuledList items={integrations.map((integration) => ({ term: integration.name, detail: integration.does }))} />
  </SellingPoint>

  <SellingPoint point={builtYourWay!} layout="stacked">
    <Fragment slot="words">
      <p><a href={pages.compare.path} class={standalone}>See how other tools price it</a></p>
    </Fragment>
    <ProductFrame
      src={templateStages}
      phoneSrc={templateStagesPhone}
      sizes="(min-width: 80rem) 74rem, 100vw"
      alt="A hiring template in ScreenHire, read back as what happens to an applicant: its stages in order from Applied, each with its time limit, its scorecard and the emails and reminders that run there."
      class="max-h-200 md:max-h-160"
    />
  </SellingPoint>

  <DarkBand labelledby="pricing-title" id="pricing" class="flex flex-wrap gap-x-16 gap-y-12">
    <div class="flex min-w-0 flex-[1_1_22rem] flex-col items-start gap-4">
      <h2 id="pricing-title" class="font-display text-section text-balance">One price for your whole team. Everything included.</h2>
      <p class="max-w-measure text-xl text-pretty">Plans differ only in how many jobs you have open at once. Jobs already open stay open if you reach the limit.</p>
      <CtaLink href={signUp} size="lg" class="mt-4">{trialLabel()}</CtaLink>
    </div>
    <div class="flex min-w-0 flex-[1_1_28rem] flex-col gap-10">
      <PlanRows trialPlan={trialPlan} />
      <div class="flex flex-col gap-3">
        <h3 class="text-xl font-bold">What you will not pay extra for</h3>
        <ul class="flex list-disc flex-col gap-2 pl-5 marker:text-muted-foreground">
          {notPaidExtra.map((item) => <li>{item}</li>)}
        </ul>
        <p class="text-pretty">
          Some tools charge for these as seats, add-ons or a higher plan.{' '}
          <a href={pages.compare.path} class="text-foreground underline underline-offset-4 hover:decoration-2">See how we compare</a>, with sources and dates.
        </p>
      </div>
    </div>
  </DarkBand>

  <QuestionsList faqs={faqs} />

  <ClosingBand title="Spend your interviews on real candidates." href={signUp} />
</BaseLayout>
