---
import schedulePhone from '../../assets/product/schedule-interview-phone.png';
import schedule from '../../assets/product/schedule-interview.png';
import tryItPhone from '../../assets/product/try-it-phone.png';
import tryIt from '../../assets/product/try-it.png';
import workflowPhone from '../../assets/product/workflow-phone.png';
import workflow from '../../assets/product/workflow.png';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageHero from '../../components/shell/PageHero.astro';
import ProductFrame from '../../components/shell/ProductFrame.astro';
import ProofList from '../../components/shell/ProofList.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import RuledList from '../../components/shell/RuledList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { automation, sellingPoints } from '../../lib/features';
import { pages } from '../../lib/pages';
import { faqPage, type Faq } from '../../lib/seo';

const { title, description, path, label } = pages.automateAnything;
const point = sellingPoints.find((item) => item.id === 'automate-anything')!;

// The triggers and actions the workflow editor offers (`triggerLabels` and `actionLabels` in the dashboard's workflow.ts,
// docs/architecture/workflow-engine.md), less the verification trigger and the rejection actions, which the site does not
// sell. Name nothing else here.
const triggers = [
  'An application arrives',
  'A candidate enters or leaves a stage',
  'Time passes in a stage',
  "A stage's time limit passes",
  'A form is answered',
  'A reviewer records a decision',
  'An interview is booked',
  'Someone runs it by hand',
];
const actions = [
  'Email the candidate',
  'Send a form',
  'Move them to a stage',
  'Tag them',
  'Ask a teammate to review',
  'Notify the team or create a task',
  'Offer interview times',
  'Call a webhook',
];

// The three ways a candidate picks an interview time, in the Schedule interview sheet's own words (docs/architecture/interview-scheduling.md).
const hands = [
  { term: 'Forms', detail: 'Send a form from your library when a candidate reaches a stage, some days later, or by hand.' },
  { term: 'Scorecards', detail: 'Ask a teammate for a scorecard. It lands on their task list.' },
  { term: 'Pick from our times', detail: "Times the interviewers are free, inside each person's own hours." },
  { term: "Tell us when you're free", detail: 'The candidate sends the times that suit them, and you book one.' },
  { term: "We'll suggest a time", detail: 'You propose a time or two, and the candidate takes one or asks for another.' },
];

const faqs: Faq[] = [
  {
    question: 'Do I need to write code or a long prompt?',
    answer: 'No. An automation is a short form: when this happens, if this is true, do this. Nothing reads a sentence and guesses what you meant.',
  },
  {
    question: 'Are automations limited on any plan?',
    answer: 'No. Every plan has every automation, on every stage and on the whole workflow.',
  },
  {
    question: 'Can an automation reject a candidate because of a check?',
    answer: 'No. An automation can tag a candidate or ask the team to review when a check finishes, and a workflow that tries to reject on one cannot be published.',
  },
  {
    question: 'Can I see what happens before a real candidate applies?',
    answer: 'Yes. Try it walks a made-up candidate through your process one stage at a time, and you can have its emails sent to you. Nothing else is saved.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: pages.product.label, path: pages.product.path }, { name: label, path }]}
  headerTone="dark"
  jsonLd={[faqPage(faqs)]}
>
  <PageHero title={point.title} lead={`${point.pain} ${point.promise}`}>
    <figure class="flex flex-col gap-4">
      <blockquote class="rounded-panel border border-border p-6 font-display text-2xl text-balance md:p-8 md:text-3xl">{automation.sentence}</blockquote>
      <figcaption class="max-w-measure text-sm text-muted-foreground">One automation, written the way you would explain it to a new hire.</figcaption>
    </figure>
  </PageHero>

  <Section labelledby="when-title" class="flex flex-col gap-10">
    <div class="flex max-w-measure flex-col gap-4">
      <h2 id="when-title" class="font-display text-section text-balance">When, if, then. From one reminder to a whole process.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">Each automation is a short form, not free text. Nothing guesses what you meant.</p>
    </div>
    <RuledList items={automation.examples.map((example) => ({ term: example.scope, detail: example.text }))} />
  </Section>

  <Section tone="band" labelledby="stages-title" class="flex flex-wrap items-center gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_20rem] flex-col gap-4">
      <h2 id="stages-title" class="font-display text-section text-balance">On any stage, or on the whole workflow.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">
        Each stage says in a few words what it sends and what runs there. A problem shows on the step that has it, before you
        publish.
      </p>
    </div>
    <ProductFrame class="flex-[1_1_32rem]" src={workflow} phoneSrc={workflowPhone} alt="A job's pipeline: each stage with how soon to respond, the emails it sends and its automations, in a few words each." sizes="(min-width: 80rem) 44rem, 100vw" />
  </Section>

  <Section labelledby="try-title" class="flex flex-wrap items-center gap-x-16 gap-y-10">
    <ProductFrame class="flex-[1_1_32rem] lg:order-first" src={tryIt} phoneSrc={tryItPhone} alt="Try it on a job's hiring process: a made-up candidate in one stage, with the email that stage sends and the step that moves them on." sizes="(min-width: 80rem) 44rem, 100vw" />
    <div class="flex min-w-0 flex-[1_1_20rem] flex-col gap-4">
      <h2 id="try-title" class="font-display text-section text-balance">Try it before a candidate does.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">
        Pick a made-up applicant, a good fit or one who says no to a must-have, and step through every stage. You see the emails,
        the tasks and who decides.
      </p>
    </div>
  </Section>

  <Section tone="band" labelledby="parts-title" class="flex flex-col gap-10">
    <h2 id="parts-title" class="max-w-3xl font-display text-section text-balance">Everything an automation can start from, and do.</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] gap-x-16 gap-y-10">
      <div>
        <h3 class="text-xl font-bold">It can start when</h3>
        <ProofList class="mt-3" items={triggers} />
      </div>
      <div>
        <h3 class="text-xl font-bold">It can then</h3>
        <ProofList class="mt-3" items={actions} />
      </div>
    </div>
  </Section>

  <Section labelledby="hands-title" class="flex flex-wrap items-start gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_24rem] flex-col gap-6">
      <h2 id="hands-title" class="font-display text-section text-balance">The follow-ups nobody wants to do by hand.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">An interview can be booked three ways. Every booking sends a calendar invite.</p>
      <RuledList items={hands} />
    </div>
    <ProductFrame class="flex-[1_1_28rem]" src={schedule} phoneSrc={schedulePhone} alt="The Schedule interview sheet, with the three ways a candidate can pick a time." sizes="(min-width: 80rem) 40rem, 100vw" />
  </Section>

  <Section tone="band" labelledby="guardrails-title" class="flex flex-wrap gap-x-16 gap-y-6">
    <h2 id="guardrails-title" class="flex-[1_1_22rem] font-display text-band text-balance">A check never rejects anyone.</h2>
    <p class="max-w-measure flex-[2_1_26rem] text-pretty text-secondary-foreground">
      An automation can tag a candidate or ask your team to review when a check finishes. It cannot reject on one, and a
      workflow that tries cannot be published. A person decides.
    </p>
  </Section>

  <QuestionsList faqs={faqs} />

  <ClosingBand title="Let ScreenHire do the same thing the same way every time." />
</BaseLayout>
