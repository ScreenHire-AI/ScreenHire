---
import brandingPhone from '../../assets/product/branding-phone.png';
import branding from '../../assets/product/branding.png';
import careersPhone from '../../assets/product/careers-phone.png';
import careers from '../../assets/product/careers.png';
import formsPhone from '../../assets/product/forms-phone.png';
import forms from '../../assets/product/forms.png';
import templatePhone from '../../assets/product/template-stages-phone.png';
import template from '../../assets/product/template-stages.png';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageHero from '../../components/shell/PageHero.astro';
import ProductFrame from '../../components/shell/ProductFrame.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import RuledList from '../../components/shell/RuledList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aiCost, sellingPoints } from '../../lib/features';
import { pages } from '../../lib/pages';
import { faqPage, type Faq } from '../../lib/seo';

const { title, description, path, label } = pages.builtYourWay;
const point = sellingPoints.find((item) => item.id === 'built-your-way')!;

// Each line is a feature in docs/status.md, Built (templates, forms, scorecards, email, settings and branding, roles and
// permissions, named teams, the verification settings, the careers site).
const yours = [
  { term: 'Forms', detail: 'Build a form once and use it on any job. The apply form shows a few questions a page.' },
  { term: 'Scorecards', detail: 'Your own questions and a required recommendation. Each stage picks one.' },
  { term: 'Email templates', detail: 'Your own words, with the candidate and job names dropped in. Send yourself a test.' },
  { term: 'Your own AI key', detail: `The AI consistency check is included in the plan. ${aiCost.billed} Use your own key and model and we charge nothing for it.` },
];

const access = [
  { term: 'Roles', detail: 'Every member has a role, built in or your own, and the server checks it on every action.' },
  { term: 'Teams', detail: "Name your teams, and a new job asks who's hiring." },
  { term: 'Job access', detail: 'A person sees only the jobs they work on, in the lists and in the reports.' },
  { term: 'History', detail: 'Every change to a template, a job, a role or a setting is recorded, with who made it and when.' },
];

const faqs: Faq[] = [
  {
    question: 'Do I have to build a template from scratch?',
    answer: 'No. Start from one of the built-in templates and change what you need, or copy one of your own.',
  },
  {
    question: 'If I change a template, do my open jobs change?',
    answer: 'No. A job keeps the version it started from, and you choose when to apply a newer one.',
  },
  {
    question: 'Can I move an open job to a different template?',
    answer: 'Yes. Pick the new template and say where each stage goes. Nobody is emailed and no automation runs on the move.',
  },
  {
    question: 'Can candidates see my colours and logo?',
    answer: 'Yes. Your careers site carries your name, logo, colours and heading font, and candidates see it before they apply.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: pages.product.label, path: pages.product.path }, { name: label, path }]}
  headerTone="dark"
  jsonLd={[faqPage(faqs)]}
>
  <PageHero title={point.title} lead={`${point.pain} ${point.promise}`}>
    <ProductFrame
      src={template}
      phoneSrc={templatePhone}
      alt="A hiring template's stages, each with the email, form or scorecard that goes with it."
      sizes="(min-width: 80rem) 40rem, 100vw"
      priority
    />
  </PageHero>

  <Section labelledby="templates-title" class="flex flex-wrap gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_22rem] flex-col gap-4">
      <h2 id="templates-title" class="font-display text-section text-balance">Start from a template. Change anything.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">
        A template holds the stages, forms, scorecards and automations for a kind of role. A job that is already open never
        changes under you, and you can move it to another template when you choose.
      </p>
    </div>
    <RuledList class="flex-[1_1_28rem]" items={yours} />
  </Section>

  <Section tone="band" labelledby="forms-title" class="flex flex-wrap items-center gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_20rem] flex-col gap-4">
      <h2 id="forms-title" class="font-display text-section text-balance">Ask the right question at the right stage.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">
        A hiring process can send several forms. Each goes when a candidate applies, reaches a stage, some days later, or when
        you send it by hand.
      </p>
    </div>
    <ProductFrame class="flex-[1_1_32rem]" src={forms} phoneSrc={formsPhone} alt="A hiring template's forms: the application form and a screening form, each with when it is sent and how many questions it has." sizes="(min-width: 80rem) 44rem, 100vw" />
  </Section>

  <Section labelledby="brand-title" class="flex flex-col gap-10">
    <div class="flex max-w-measure flex-col gap-4">
      <h2 id="brand-title" class="font-display text-section text-balance">It looks like your company.</h2>
      <p class="text-pretty text-secondary-foreground">
        Your logo, your colours and any heading font from Google Fonts, which we host for you. Your careers site and your emails
        take them on.
      </p>
    </div>
    <div class="flex flex-wrap items-start gap-5">
      <ProductFrame class="min-w-0 flex-[2_1_22rem]" src={branding} phoneSrc={brandingPhone} alt="The branding editor, with the logo, colour and font choices and a preview." sizes="(min-width: 80rem) 36rem, 100vw" />
      <ProductFrame class="min-w-0 flex-[3_1_26rem]" src={careers} phoneSrc={careersPhone} alt="A company's branded careers site with its open roles." sizes="(min-width: 80rem) 44rem, 100vw" />
    </div>
  </Section>

  <Section tone="band" labelledby="access-title" class="flex flex-wrap gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_22rem] flex-col gap-4">
      <h2 id="access-title" class="font-display text-section text-balance">Who sees what is up to you.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">Hiring involves people who should not see everything.</p>
    </div>
    <RuledList class="flex-[1_1_28rem]" items={access} />
  </Section>

  <QuestionsList faqs={faqs} />

  <ClosingBand title="Start from a template this afternoon." />
</BaseLayout>
