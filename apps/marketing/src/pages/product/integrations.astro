---
import integrationsPhone from '../../assets/product/integrations-phone.png';
import integrationsPicture from '../../assets/product/integrations.png';
import AssistantAsks from '../../components/shell/AssistantAsks.astro';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageHero from '../../components/shell/PageHero.astro';
import ProductFrame from '../../components/shell/ProductFrame.astro';
import ProofList from '../../components/shell/ProofList.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import RuledList from '../../components/shell/RuledList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aiCost, sellingPoints } from '../../lib/features';
import { pages } from '../../lib/pages';
import { faqPage, type Faq } from '../../lib/seo';

const { title, description, path, label } = pages.integrations;
const point = sellingPoints.find((item) => item.id === 'integrations')!;

// Each line is a feature in docs/status.md, Built (email and replies, interview scheduling, Slack, API access, webhook
// subscriptions, the MCP server, the verification settings).
const each = [
  {
    term: 'Email',
    detail: 'Send from ScreenHire with your own templates. Replies land on the candidate, attachments included, and you can send from your own domain.',
  },
  {
    term: 'Calendars',
    detail:
      "Each interviewer connects Google or Outlook, or just sets their hours. Candidates pick from your times, tell you when they are free, or take a time you suggest. Every booking sends an invite.",
  },
  {
    term: 'Slack',
    detail: 'New applications, moves, failed automations and published jobs in the channel you pick. Mentions and tasks as direct messages.',
  },
  {
    term: 'API and webhooks',
    detail: 'Read and change jobs, applications, candidates, scorecards, templates and reports. Webhooks send a signed message when something happens.',
  },
  {
    term: 'AI assistants',
    detail: 'Connect an assistant such as Claude through MCP to find candidates, read an application, add notes and move people along.',
  },
  {
    term: 'Your own AI key',
    detail: `The AI consistency check is included in the plan. ${aiCost.billed} If you would rather use your own key and model, add them in settings and we charge nothing for it.`,
  },
];

// The MCP server asks the person before these (docs/architecture/mcp-server.md, "Confirmation").
const asksFirst = ['Send an email', 'Invite a candidate to an interview', 'Publish or close a job', 'Move a candidate to a rejected stage'];

const api = [
  'Keys are shown once, can be read-only or read and write, and can be revoked',
  'Jobs, applications, candidates, scorecards, templates and reports are in the API',
  'The reference lists every route a key can call',
];
const webhooks = [
  'Each endpoint has its own secret, shown once and rotatable',
  'Deliveries are signed, retried and kept in a log you can replay from',
  'An endpoint that keeps failing is switched off for you',
];

const faqs: Faq[] = [
  {
    question: 'Are the API, webhooks and MCP on every plan?',
    answer: 'Yes. Every plan has every integration.',
  },
  {
    question: 'What can an AI assistant not do?',
    answer: 'A read-only key sees only the reads. An assistant can read the results of the checks only with a key an Owner has given that access. Every such read is logged, and a result is never a reason to reject.',
  },
  {
    question: 'Does Slack show what ScreenHire found about a candidate?',
    answer:
      'No. Channel messages name the candidate and the job and link to them. A reviewer can get a direct message that an application needs a closer look, without the candidate\'s name. No message carries a level or its evidence.',
  },
  {
    question: 'Can a candidate answer an email from ScreenHire?',
    answer: 'Yes. They can reply to the email or from their own page, and the reply lands on their application.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: pages.product.label, path: pages.product.path }, { name: label, path }]}
  headerTone="dark"
  jsonLd={[faqPage(faqs)]}
>
  <PageHero title={point.title} lead={`${point.pain} ${point.promise}`}>
    <ProductFrame
      src={integrationsPicture}
      phoneSrc={integrationsPhone}
      alt="Slack connected in Settings, whose menu lists each integration beside the other settings."
      sizes="(min-width: 80rem) 40rem, 100vw"
      priority
    />
  </PageHero>

  <Section labelledby="each-title" class="flex flex-wrap gap-x-16 gap-y-10">
    <h2 id="each-title" class="flex-[1_1_16rem] font-display text-band text-balance">What each one does.</h2>
    <RuledList class="flex-[3_1_36rem]" items={each} />
  </Section>

  <Section tone="band" labelledby="asks-title" class="flex flex-wrap items-start gap-x-16 gap-y-10">
    <div class="flex min-w-0 flex-[1_1_20rem] flex-col gap-4">
      <h2 id="asks-title" class="font-display text-section text-balance">Your assistant asks before it acts.</h2>
      <p class="max-w-measure text-pretty text-secondary-foreground">Reading and notes just happen. These wait for your yes:</p>
      <ProofList items={asksFirst} />
    </div>
    <figure class="flex min-w-0 flex-[1_1_28rem] flex-col gap-3">
      <AssistantAsks />
      <figcaption class="text-sm text-muted-foreground">Sample request. The people here are fictional.</figcaption>
    </figure>
  </Section>

  <Section labelledby="build-title" class="flex flex-col gap-10">
    <div class="flex max-w-measure flex-col items-start gap-4">
      <h2 id="build-title" class="font-display text-section text-balance">Build on ScreenHire.</h2>
      <p class="text-pretty text-secondary-foreground">The API and webhooks are on every plan, with no extra fee.</p>
      <a href={pages.developers.path} class="inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4 hover:decoration-2">Read the developer docs</a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(20rem,1fr))] gap-x-16 gap-y-10">
      <div>
        <h3 class="text-xl font-bold">The API</h3>
        <ProofList class="mt-3" items={api} />
      </div>
      <div>
        <h3 class="text-xl font-bold">Webhooks</h3>
        <ProofList class="mt-3" items={webhooks} />
      </div>
    </div>
  </Section>

  <QuestionsList faqs={faqs} tone="band" />

  <ClosingBand title="Keep the tools you already use." />
</BaseLayout>
