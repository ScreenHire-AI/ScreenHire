---
import careersPhone from '../../assets/product/careers-phone.png';
import careers from '../../assets/product/careers.png';
import postingsPhone from '../../assets/product/job-postings-phone.png';
import postings from '../../assets/product/job-postings.png';
import ClosingBand from '../../components/shell/ClosingBand.astro';
import PageHero from '../../components/shell/PageHero.astro';
import ProductFrame from '../../components/shell/ProductFrame.astro';
import QuestionsList from '../../components/shell/QuestionsList.astro';
import RuledList from '../../components/shell/RuledList.astro';
import Section from '../../components/shell/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { careersSite } from '../../lib/features';
import { pages } from '../../lib/pages';
import { faqPage, type Faq } from '../../lib/seo';

const { title, description, path, label } = pages.careersSite;

// Each line is a feature in docs/status.md, Built (careers site, careers widget, distribution, manual postings, apply flow,
// candidate portal).
const posting = [
  { term: 'Your careers site', detail: 'Every job you publish gets a page with your branding, quick to load on a phone.' },
  { term: 'On your own site', detail: 'The job list and the apply form inside your website, from one line of embed code.' },
  { term: 'Google for Jobs and job boards', detail: 'One step publishes to each. A board that refreshes on a schedule says when the job should come down, never a false "removed".' },
  { term: 'Post it yourself', detail: 'For a board with no feed, copy the text, post it, and the tracked link counts who came from there.' },
  { term: 'Taking it down', detail: 'One close takes the job off your careers site and asks every board to remove it.' },
];

const notice = [
  { term: 'Before they start', detail: 'A candidate reads in plain words what is collected and why. Browsing your careers page collects only the logs any website keeps.' },
  { term: 'Assistive technology', detail: 'A candidate who uses it can switch a setting off before they start, and it is never held against them.' },
  { term: 'A short form', detail: 'A few questions a page and one progress bar. They can save it and finish from an emailed link.' },
  { term: 'Where they stand', detail: 'Afterwards they have a page of their own to see their application, answer your messages and pick an interview time.' },
];

const faqs: Faq[] = [
  {
    question: 'Do candidates need an account to apply?',
    answer: 'No. They fill in a web form that works even with JavaScript turned off.',
  },
  {
    question: 'Can I put the apply form on my own website?',
    answer: 'Yes. Paste one line of embed code. The form runs in a frame, and only the sites you allow can show it.',
  },
  {
    question: 'What does a candidate see about the checks?',
    answer: 'A notice, before they start, that says what is collected and why. They never see a result.',
  },
  {
    question: 'Does closing a job take it down everywhere?',
    answer: 'It closes on your careers site and goes to every board together. Each board shows its own status until it has taken the job down.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: pages.product.label, path: pages.product.path }, { name: label, path }]}
  headerTone="dark"
  jsonLd={[faqPage(faqs)]}
>
  <PageHero title={careersSite.title} lead={`${careersSite.pain} ${careersSite.promise}`}>
    <ProductFrame
      src={careers}
      phoneSrc={careersPhone}
      alt="A company's branded careers site with its open roles."
      sizes="(min-width: 80rem) 40rem, 100vw"
      priority
    />
  </PageHero>

  <Section labelledby="posting-title" class="flex flex-col gap-10">
    <div class="flex flex-wrap items-end gap-x-16 gap-y-4">
      <h2 id="posting-title" class="flex-[1_1_24rem] font-display text-section text-balance">Publish once, and see where it stands.</h2>
      <p class="max-w-measure flex-[1_1_22rem] text-pretty text-secondary-foreground">
        Every place a job is posted sits in one list, with an honest status for each.
      </p>
    </div>
    <div class="flex flex-wrap items-start gap-x-16 gap-y-10">
      <ProductFrame class="min-w-0 flex-[3_1_30rem]" src={postings} phoneSrc={postingsPhone} alt="A job's postings: its careers page and job boards with their status, and a board posted by hand with its tracked link." sizes="(min-width: 80rem) 44rem, 100vw" />
      <RuledList class="min-w-0 flex-[2_1_22rem]" items={posting} />
    </div>
  </Section>

  <Section tone="band" labelledby="notice-title" class="flex flex-col gap-10">
    <div class="flex max-w-measure flex-col gap-4">
      <h2 id="notice-title" class="font-display text-section text-balance">Candidates are told before they apply.</h2>
      <p class="text-pretty text-secondary-foreground">
        The people you want to hire notice how they are treated. Your careers site tells them what happens before they start.
      </p>
    </div>
    <RuledList items={notice} />
  </Section>

  <QuestionsList faqs={faqs} />

  <ClosingBand title="Post your first job this afternoon." />
</BaseLayout>
