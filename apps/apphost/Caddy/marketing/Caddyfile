# The built marketing site as it ships: Astro's static dist/, mounted at /srv by the AppHost, with its 404 page for any
# path that is not a file. Used with ScreenHire:Frontends=Built only; `pnpm dev` runs Astro's dev server.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
