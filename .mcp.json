{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY:-}"
      }
    },
    "aspire": {
      "command": "dotnet",
      "args": [
        "tool",
        "run",
        "aspire",
        "agent",
        "mcp"
      ],
      "env": {
        "ASPIRE_CLI_TELEMETRY_OPTOUT": "true"
      }
    }
  }
}
