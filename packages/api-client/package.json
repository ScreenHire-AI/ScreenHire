{
  "name": "@screenhire/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client and Zod schemas generated by Orval from the API's OpenAPI document (openapi.json is written by the API build).",
  "exports": {
    ".": "./src/index.ts",
    "./svelte-query": "./src/svelte-query.ts",
    "./zod": "./src/generated/zod.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run --fsModuleCachePath=node_modules/.vitest-cache"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/svelte-query": "^6.3.5",
    "orval": "^8.43.0",
    "svelte": "^5.57.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@tanstack/svelte-query": "^6.3.5"
  },
  "peerDependenciesMeta": {
    "@tanstack/svelte-query": {
      "optional": true
    }
  }
}
