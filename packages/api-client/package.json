{
  "name": "@screenhire/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client and Zod schemas generated by Orval from the API's OpenAPI document (openapi.json is written by the API build).",
  "exports": {
    ".": "./src/index.ts",
    "./zod": "./src/generated/zod.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "orval": "^8.43.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
