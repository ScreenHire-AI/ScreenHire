{
  "openapi": "3.1.1",
  "info": {
    "title": "ScreenHire.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "GetMeta",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiMeta"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/providers": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetSignInMethods",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInMethods"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/auth/challenge/{provider}": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "ChallengeProvider",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/auth/magic-link": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "RequestMagicLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/auth/magic-link/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "VerifyMagicLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkVerification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/auth/onboarding": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "CompleteOnboarding",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "SignOut",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/public/organizations/{organizationSlug}/jobs": {
      "get": {
        "tags": [
          "Public careers"
        ],
        "operationId": "ListPublicJobs",
        "parameters": [
          {
            "name": "organizationSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicJobBoard"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/public/organizations/{organizationSlug}/jobs/{jobSlug}": {
      "get": {
        "tags": [
          "Public careers"
        ],
        "operationId": "GetPublicJob",
        "parameters": [
          {
            "name": "organizationSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "jobSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicJob"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "operationId": "ListJobs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/jobs/{jobId}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "operationId": "GetJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiMeta": {
        "required": [
          "name",
          "version",
          "environment"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        },
        "description": "What is serving this API: the product name, the build version and the hosting environment."
      },
      "CurrentOrganization": {
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/OrganizationRole"
          }
        },
        "description": "The organization the signed-in user works in, and their role there."
      },
      "CurrentUser": {
        "required": [
          "id",
          "email",
          "displayName",
          "organization"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "organization": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentOrganization"
              }
            ]
          }
        },
        "description": "The signed-in user, and the organization they work in (null until onboarding)."
      },
      "EmploymentType": {
        "enum": [
          "FullTime",
          "PartTime",
          "Contract",
          "Temporary",
          "Internship"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JobStatus": {
        "enum": [
          "Draft",
          "Open",
          "Closed"
        ]
      },
      "JobSummary": {
        "required": [
          "id",
          "title",
          "slug",
          "location",
          "workplaceType",
          "status",
          "createdAt",
          "publishedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "workplaceType": {
            "$ref": "#/components/schemas/WorkplaceType"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "A job as shown in the recruiter dashboard."
      },
      "MagicLinkRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "description": "Asks for a sign-in link by email."
      },
      "MagicLinkVerification": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "description": "Redeems the token from an emailed sign-in link."
      },
      "OnboardingRequest": {
        "required": [
          "organizationName",
          "slug"
        ],
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "description": "Creates the signed-in user's organization, with them as its Owner."
      },
      "OrganizationRole": {
        "enum": [
          "Owner",
          "Admin",
          "Recruiter",
          "Viewer"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublicJob": {
        "required": [
          "id",
          "title",
          "slug",
          "location",
          "workplaceType",
          "employmentType",
          "salaryMin",
          "salaryMax",
          "salaryCurrency",
          "publishedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "workplaceType": {
            "$ref": "#/components/schemas/WorkplaceType"
          },
          "employmentType": {
            "$ref": "#/components/schemas/EmploymentType"
          },
          "salaryMin": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "salaryMax": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "salaryCurrency": {
            "type": [
              "null",
              "string"
            ]
          },
          "publishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "A job as shown on a public careers page."
      },
      "PublicJobBoard": {
        "required": [
          "organizationName",
          "organizationSlug",
          "jobs"
        ],
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string"
          },
          "organizationSlug": {
            "type": "string"
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicJob"
            }
          }
        },
        "description": "The public careers listing for one organization."
      },
      "SignInMethods": {
        "required": [
          "providers",
          "magicLinkEnabled"
        ],
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignInProvider"
            }
          },
          "magicLinkEnabled": {
            "type": "boolean"
          }
        },
        "description": "How a person can sign in here: the configured identity providers, and whether email links work."
      },
      "SignInProvider": {
        "required": [
          "id",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "description": "An identity provider button on the sign-in page."
      },
      "WorkplaceType": {
        "enum": [
          "Onsite",
          "Hybrid",
          "Remote"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Meta"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Public careers"
    },
    {
      "name": "Jobs"
    }
  ]
}